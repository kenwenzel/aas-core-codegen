    skos:inScheme <https://admin-shell.io/aas/3/0/RC02> .

aas:sourceSemanticId a owl:ObjectProperty ;
    rdfs:label "sourceSemanticId" ;
    skos:definition "'semanticId' of the source event element, if available" ;
    skos:inScheme <https://admin-shell.io/aas/3/0/RC02> .

aas:specificAssetId a owl:ObjectProperty ;
    rdfs:label "specificAssetId" ;
    skos:definition "Reference to a specific asset ID representing a supplementary identifier of the asset represented by the Asset Administration Shell." ;
    skos:inScheme <https://admin-shell.io/aas/3/0/RC02> .

