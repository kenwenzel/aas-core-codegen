            owl:minCardinality 1 ;
            owl:onProperty aas:contentType ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:intersectionOf ( xsd:string [ a rdfs:Datatype ;
                                owl:onDatatype xsd:string ;
                                owl:withRestrictions ( [ xsd:pattern "^([!#$%&'*+\\-.^_`|~0-9a-zA-Z])+/([!#$%&'*+\\-.^_`|~0-9a-zA-Z])+([ \\t]*;[ \\t]*([!#$%&'*+\\-.^_`|~0-9a-zA-Z])+=(([!#$%&'*+\\-.^_`|~0-9a-zA-Z])+|\"(([\\t !#-\\[\\]-~]|[\\x80-\\xff])|\\\\([\\t !-~]|[\\x80-\\xff]))*\"))*$" ] ) ] ) ] ;
            owl:onProperty aas:contentType ],
        aas:DataElement ;
    skos:definition "A File is a data element that represents an address to a file (a locator)." ;
    skos:inScheme <https://admin-shell.io/aas/3/0/RC02> .

aas:MultiLanguageProperty a owl:Class ;
    rdfs:label "MultiLanguageProperty" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty aas:valueId ],
        [ a owl:Restriction ;
            owl:allValuesFrom aas:Reference ;
            owl:onProperty aas:valueId ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty aas:valueId ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty aas:value ],
        [ a owl:Restriction ;
            owl:allValuesFrom rdf:langString ;
            owl:onProperty aas:value ],
        aas:DataElement ;
    skos:definition "A property is a data element that has a multi-language value." ;
    skos:inScheme <https://admin-shell.io/aas/3/0/RC02> .

aas:Operation a owl:Class ;
    rdfs:label "Operation" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty aas:inputVariables ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty aas:inoutputVariables ],
        [ a owl:Restriction ;
            owl:allValuesFrom aas:OperationVariable ;
            owl:onProperty aas:outputVariables ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty aas:outputVariables ],
        [ a owl:Restriction ;
            owl:allValuesFrom aas:OperationVariable ;
            owl:onProperty aas:inoutputVariables ],
        [ a owl:Restriction ;
            owl:allValuesFrom aas:OperationVariable ;
            owl:onProperty aas:inputVariables ],
        aas:SubmodelElement ;
    skos:definition "An operation is a submodel element with input and output variables." ;
    skos:inScheme <https://admin-shell.io/aas/3/0/RC02> .

aas:Property a owl:Class ;
    rdfs:label "Property" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty aas:value ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty aas:value ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty aas:valueType ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty aas:valueId ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty aas:valueType ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty aas:valueId ],
        [ a owl:Restriction ;
            owl:allValuesFrom aas:Reference ;
            owl:onProperty aas:valueId ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty aas:value ],
        [ a owl:Restriction ;
            owl:allValuesFrom aas:DataTypeDefXsd ;
            owl:onProperty aas:valueType ],
        aas:DataElement ;
    skos:definition "A property is a data element that has a single value." ;
    skos:inScheme <https://admin-shell.io/aas/3/0/RC02> .

aas:Range a owl:Class ;
    rdfs:label "Range" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty aas:valueType ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty aas:valueType ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty aas:min ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty aas:max ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty aas:min ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty aas:max ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty aas:max ],
        [ a owl:Restriction ;
            owl:allValuesFrom aas:DataTypeDefXsd ;
            owl:onProperty aas:valueType ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty aas:min ],
        aas:DataElement ;
    skos:definition "A range data element is a data element that defines a range with min and max." ;
    skos:inScheme <https://admin-shell.io/aas/3/0/RC02> .

aas:ReferenceElement a owl:Class ;
    rdfs:label "ReferenceElement" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom aas:Reference ;
            owl:onProperty aas:value ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty aas:value ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty aas:value ],
        aas:DataElement ;
    skos:definition "A reference element is a data element that defines a logical reference to another element within the same or another AAS or a reference to an external object or entity." ;
    skos:inScheme <https://admin-shell.io/aas/3/0/RC02> .

aas:SubmodelElementCollection a owl:Class ;
    rdfs:label "SubmodelElementCollection" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty aas:value ],
        [ a owl:Restriction ;
            owl:allValuesFrom aas:SubmodelElement ;
            owl:onProperty aas:value ],
        aas:SubmodelElement ;
    skos:definition "A submodel element collection is a kind of struct, i.e. a a logical encapsulation of multiple named values. It has a fixed number of submodel elements." ;
    skos:inScheme <https://admin-shell.io/aas/3/0/RC02> .

aas:SubmodelElementList a owl:Class ;
    rdfs:label "SubmodelElementList" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom aas:DataTypeDefXsd ;
            owl:onProperty aas:valueTypeListElement ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty aas:valueTypeListElement ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty aas:semanticIdListElement ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty aas:valueTypeListElement ],
        [ a owl:Restriction ;
            owl:allValuesFrom aas:AasSubmodelElements ;
            owl:onProperty aas:typeValueListElement ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty aas:typeValueListElement ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty aas:orderRelevant ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty aas:value ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:boolean ;
            owl:onProperty aas:orderRelevant ],
        [ a owl:Restriction ;
            owl:allValuesFrom aas:Reference ;
            owl:onProperty aas:semanticIdListElement ],
        [ a owl:Restriction ;
            owl:allValuesFrom aas:SubmodelElement ;
            owl:onProperty aas:value ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty aas:orderRelevant ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty aas:typeValueListElement ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty aas:semanticIdListElement ],
        aas:SubmodelElement ;
    skos:definition "A submodel element list is an ordered list of submodel elements." ;
    skos:inScheme <https://admin-shell.io/aas/3/0/RC02> .

xsd:base64Binary a rdfs:Datatype .

aas:AdministrativeInformation a owl:Class ;
    rdfs:label "AdministrativeInformation" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty aas:revision ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty aas:version ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty aas:version ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty aas:revision ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty aas:revision ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty aas:version ],
        aas:HasDataSpecification ;
    skos:definition "Administrative meta-information for an element like version information." ;
    skos:inScheme <https://admin-shell.io/aas/3/0/RC02> .

aas:AssetAdministrationShell a owl:Class ;
    rdfs:label "AssetAdministrationShell" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom aas:AssetInformation ;
            owl:onProperty aas:assetInformation ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty aas:derivedFrom ],
        [ a owl:Restriction ;
            owl:allValuesFrom aas:Reference ;
            owl:onProperty aas:derivedFrom ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty aas:assetInformation ],
        [ a owl:Restriction ;
            owl:allValuesFrom aas:Reference ;
            owl:onProperty aas:submodels ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty aas:assetInformation ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty aas:submodels ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty aas:derivedFrom ],
        aas:HasDataSpecification,
        aas:Identifiable ;
    skos:definition "An asset administration shell." ;
    skos:inScheme <https://admin-shell.io/aas/3/0/RC02> .

aas:AssetInformation a owl:Class ;
    rdfs:label "AssetInformation" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty aas:assetKind ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty aas:defaultThumbnail ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty aas:specificAssetIds ],
        [ a owl:Restriction ;
            owl:allValuesFrom aas:SpecificAssetId ;
            owl:onProperty aas:specificAssetIds ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty aas:globalAssetId ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty aas:assetKind ],
        [ a owl:Restriction ;
            owl:allValuesFrom aas:Reference ;
            owl:onProperty aas:globalAssetId ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty aas:globalAssetId ],
        [ a owl:Restriction ;
            owl:allValuesFrom aas:AssetKind ;
            owl:onProperty aas:assetKind ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty aas:defaultThumbnail ],
        [ a owl:Restriction ;
            owl:allValuesFrom aas:Resource ;
            owl:onProperty aas:defaultThumbnail ] ;
    skos:definition "In 'AssetInformation' identifying meta data of the asset that is represented by an AAS is defined." ;
    skos:inScheme <https://admin-shell.io/aas/3/0/RC02> .

aas:ConceptDescription a owl:Class ;
    rdfs:label "ConceptDescription" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom aas:Reference ;
            owl:onProperty aas:isCaseOf ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty aas:isCaseOf ],
        aas:HasDataSpecification,
        aas:Identifiable ;
    skos:definition "The semantics of a property or other elements that may have a semantic description is defined by a concept description." ;
    skos:inScheme <https://admin-shell.io/aas/3/0/RC02> .

aas:EmbeddedDataSpecification a owl:Class ;
    rdfs:label "EmbeddedDataSpecification" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom aas:Reference ;
            owl:onProperty aas:dataSpecification ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty aas:dataSpecificationContent ],
        [ a owl:Restriction ;
            owl:allValuesFrom aas:DataSpecificationContent ;
            owl:onProperty aas:dataSpecificationContent ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty aas:dataSpecification ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty aas:dataSpecification ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty aas:dataSpecificationContent ] ;
    skos:definition "Embed the content of a data specification." ;
    skos:inScheme <https://admin-shell.io/aas/3/0/RC02> .

aas:EventElement a owl:Class ;
    rdfs:label "EventElement" ;
    rdfs:subClassOf aas:SubmodelElement ;
    skos:definition "An event element." ;
    skos:inScheme <https://admin-shell.io/aas/3/0/RC02> .

aas:Extension a owl:Class ;
    rdfs:label "Extension" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty aas:value ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty aas:name ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty aas:name ],
        [ a owl:Restriction ;
            owl:allValuesFrom aas:DataTypeDefXsd ;
            owl:onProperty aas:valueType ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty aas:refersTo ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty aas:value ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty aas:refersTo ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty aas:value ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty aas:valueType ],
        [ a owl:Restriction ;
            owl:allValuesFrom aas:Reference ;
            owl:onProperty aas:refersTo ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty aas:name ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty aas:valueType ],
        aas:HasSemantics ;
    skos:definition "Single extension of an element." ;
    skos:inScheme <https://admin-shell.io/aas/3/0/RC02> .

aas:HasExtensions a owl:Class ;
    rdfs:label "HasExtensions" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty aas:extensions ],
        [ a owl:Restriction ;
            owl:allValuesFrom aas:Extension ;
            owl:onProperty aas:extensions ] ;
    skos:definition "Element that can be extended by proprietary extensions." ;
    skos:inScheme <https://admin-shell.io/aas/3/0/RC02> .

aas:Key a owl:Class ;
    rdfs:label "Key" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty aas:type ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty aas:value ],
        [ a owl:Restriction ;
            owl:allValuesFrom aas:KeyTypes ;
            owl:onProperty aas:type ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty aas:value ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty aas:value ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty aas:type ] ;
    skos:definition "A key is a reference to an element by its ID." ;
    skos:inScheme <https://admin-shell.io/aas/3/0/RC02> .

aas:Qualifier a owl:Class ;
    rdfs:label "Qualifier" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty aas:valueId ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty aas:valueType ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty aas:kind ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty aas:kind ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty aas:value ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty aas:type ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty aas:valueId ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty aas:value ],
        [ a owl:Restriction ;
            owl:allValuesFrom aas:Reference ;
            owl:onProperty aas:valueId ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty aas:valueType ],
        [ a owl:Restriction ;
