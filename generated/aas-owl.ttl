@prefix aas: <https://admin-shell.io/aas/3/0/RC02/> .
@prefix linkml: <https://w3id.org/linkml/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://admin-shell.io/aas/3/0/RC02.owl.ttl> a owl:Ontology ;
    rdfs:label "aas" .

aas:AnnotatedRelationshipElement a owl:Class ;
    rdfs:label "AnnotatedRelationshipElement" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty aas:annotations ],
        [ a owl:Restriction ;
            owl:allValuesFrom aas:DataElement ;
            owl:onProperty aas:annotations ],
        aas:RelationshipElement ;
    skos:definition "An annotated relationship element is a relationship element that can be annotated with additional data elements." ;
    skos:inScheme <https://admin-shell.io/aas/3/0/RC02> .

aas:BasicEventElement a owl:Class ;
    rdfs:label "BasicEventElement" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty aas:direction ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty aas:state ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:intersectionOf ( xsd:string [ a rdfs:Datatype ;
                                owl:onDatatype xsd:string ;
                                owl:withRestrictions ( [ xsd:pattern "^-?(([1-9][0-9][0-9][0-9]+)|(0[0-9][0-9][0-9]))-((0[1-9])|(1[0-2]))-((0[1-9])|([12][0-9])|(3[01]))T(((([01][0-9])|(2[0-3])):[0-5][0-9]:([0-5][0-9])(\\.[0-9]+)?)|24:00:00(\\.0+)?)Z$" ] ) ] ) ] ;
            owl:onProperty aas:minInterval ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty aas:lastUpdate ],
        [ a owl:Restriction ;
            owl:allValuesFrom aas:Reference ;
            owl:onProperty aas:observed ],
        [ a owl:Restriction ;
            owl:allValuesFrom aas:Reference ;
            owl:onProperty aas:messageBroker ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty aas:minInterval ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty aas:state ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty aas:messageBroker ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:intersectionOf ( xsd:string [ a rdfs:Datatype ;
                                owl:onDatatype xsd:string ;
                                owl:withRestrictions ( [ xsd:pattern "^-?(([1-9][0-9][0-9][0-9]+)|(0[0-9][0-9][0-9]))-((0[1-9])|(1[0-2]))-((0[1-9])|([12][0-9])|(3[01]))T(((([01][0-9])|(2[0-3])):[0-5][0-9]:([0-5][0-9])(\\.[0-9]+)?)|24:00:00(\\.0+)?)Z$" ] ) ] ) ] ;
            owl:onProperty aas:maxInterval ],
        [ a owl:Restriction ;
            owl:allValuesFrom aas:Direction ;
            owl:onProperty aas:direction ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty aas:messageBroker ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty aas:lastUpdate ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty aas:maxInterval ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty aas:observed ],
        [ a owl:Restriction ;
            owl:allValuesFrom aas:StateOfEvent ;
            owl:onProperty aas:state ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:intersectionOf ( xsd:string [ a rdfs:Datatype ;
                                owl:onDatatype xsd:string ;
                                owl:withRestrictions ( [ xsd:pattern "^-?(([1-9][0-9][0-9][0-9]+)|(0[0-9][0-9][0-9]))-((0[1-9])|(1[0-2]))-((0[1-9])|([12][0-9])|(3[01]))T(((([01][0-9])|(2[0-3])):[0-5][0-9]:([0-5][0-9])(\\.[0-9]+)?)|24:00:00(\\.0+)?)Z$" ] ) ] ) ] ;
            owl:onProperty aas:lastUpdate ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty aas:direction ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty aas:messageTopic ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty aas:messageTopic ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty aas:messageTopic ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty aas:maxInterval ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty aas:minInterval ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty aas:observed ],
        aas:EventElement ;
    skos:definition "A basic event element." ;
    skos:inScheme <https://admin-shell.io/aas/3/0/RC02> .

aas:Blob a owl:Class ;
    rdfs:label "Blob" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty aas:contentType ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty aas:value ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:base64Binary ;
            owl:onProperty aas:value ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty aas:value ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:intersectionOf ( xsd:string [ a rdfs:Datatype ;
                                owl:onDatatype xsd:string ;
                                owl:withRestrictions ( [ xsd:pattern "^([!#$%&'*+\\-.^_`|~0-9a-zA-Z])+/([!#$%&'*+\\-.^_`|~0-9a-zA-Z])+([ \\t]*;[ \\t]*([!#$%&'*+\\-.^_`|~0-9a-zA-Z])+=(([!#$%&'*+\\-.^_`|~0-9a-zA-Z])+|\"(([\\t !#-\\[\\]-~]|[\\x80-\\xff])|\\\\([\\t !-~]|[\\x80-\\xff]))*\"))*$" ] ) ] ) ] ;
            owl:onProperty aas:contentType ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty aas:contentType ],
        aas:DataElement ;
    skos:definition "A 'Blob' is a data element that represents a file that is contained with its source code in the value attribute." ;
    skos:inScheme <https://admin-shell.io/aas/3/0/RC02> .

aas:Capability a owl:Class ;
    rdfs:label "Capability" ;
    rdfs:subClassOf aas:SubmodelElement ;
    skos:definition "A capability is the implementation-independent description of the potential of an asset to achieve a certain effect in the physical or virtual world." ;
    skos:inScheme <https://admin-shell.io/aas/3/0/RC02> .

aas:DataSpecificationIec61360 a owl:Class ;
    rdfs:label "DataSpecificationIec61360" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty aas:valueList ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty aas:shortName ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty aas:sourceOfDefinition ],
        [ a owl:Restriction ;
            owl:allValuesFrom aas:LevelType ;
            owl:onProperty aas:levelType ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty aas:value ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty aas:symbol ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty aas:valueFormat ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty aas:value ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty aas:levelType ],
        [ a owl:Restriction ;
            owl:allValuesFrom rdf:langString ;
            owl:onProperty aas:definition ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty aas:unit ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty aas:sourceOfDefinition ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty aas:valueList ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty aas:unit ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty aas:unitId ],
        [ a owl:Restriction ;
            owl:allValuesFrom aas:Reference ;
            owl:onProperty aas:unitId ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty aas:valueFormat ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty aas:symbol ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty aas:dataType ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty aas:unit ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty aas:valueFormat ],
        [ a owl:Restriction ;
            owl:allValuesFrom aas:DataTypeIec61360 ;
            owl:onProperty aas:dataType ],
        [ a owl:Restriction ;
            owl:allValuesFrom aas:ValueList ;
            owl:onProperty aas:valueList ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty aas:unitId ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty aas:sourceOfDefinition ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty aas:symbol ],
        [ a owl:Restriction ;
            owl:allValuesFrom rdf:langString ;
            owl:onProperty aas:shortName ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty aas:preferredName ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty aas:value ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty aas:definition ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty aas:levelType ],
        [ a owl:Restriction ;
            owl:allValuesFrom rdf:langString ;
            owl:onProperty aas:preferredName ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty aas:dataType ],
        aas:DataSpecificationContent ;
    skos:definition "Content of data specification template for concept descriptions for properties, values and value lists conformant to IEC 61360." ;
    skos:inScheme <https://admin-shell.io/aas/3/0/RC02> .

aas:DataSpecificationPhysicalUnit a owl:Class ;
    rdfs:label "DataSpecificationPhysicalUnit" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty aas:eceCode ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty aas:registrationAuthorityId ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty aas:supplier ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty aas:siName ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty aas:eceCode ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty aas:definition ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty aas:supplier ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty aas:conversionFactor ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty aas:unitName ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty aas:registrationAuthorityId ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty aas:eceName ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty aas:siName ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty aas:siName ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty aas:eceName ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty aas:unitName ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty aas:registrationAuthorityId ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty aas:dinNotation ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty aas:siNotation ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty aas:sourceOfDefinition ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty aas:sourceOfDefinition ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty aas:siNotation ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty aas:unitSymbol ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty aas:unitSymbol ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty aas:dinNotation ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty aas:nistName ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty aas:conversionFactor ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty aas:dinNotation ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty aas:eceCode ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty aas:supplier ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty aas:nistName ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty aas:sourceOfDefinition ],
        [ a owl:Restriction ;
