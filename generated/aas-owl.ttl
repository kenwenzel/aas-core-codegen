        <https://admin-shell.io/aas/3/0/RC02/ModelingKind#Template> .

aas:OperationVariable a owl:Class ;
    rdfs:label "OperationVariable" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom aas:SubmodelElement ;
            owl:onProperty aas:value ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty aas:value ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty aas:value ] ;
    skos:definition "The value of an operation variable is a submodel element that is used as input and/or output variable of an operation." ;
    skos:inScheme <https://admin-shell.io/aas/3/0/RC02> .

aas:ReferenceTypes a owl:Class ;
    owl:unionOf ( <https://admin-shell.io/aas/3/0/RC02/ReferenceTypes#GlobalReference> <https://admin-shell.io/aas/3/0/RC02/ReferenceTypes#ModelReference> ) ;
    linkml:permissible_values <https://admin-shell.io/aas/3/0/RC02/ReferenceTypes#GlobalReference>,
        <https://admin-shell.io/aas/3/0/RC02/ReferenceTypes#ModelReference> .

aas:StateOfEvent a owl:Class ;
    owl:unionOf ( <https://admin-shell.io/aas/3/0/RC02/StateOfEvent#True> <https://admin-shell.io/aas/3/0/RC02/StateOfEvent#False> ) ;
    linkml:permissible_values <https://admin-shell.io/aas/3/0/RC02/StateOfEvent#False>,
        <https://admin-shell.io/aas/3/0/RC02/StateOfEvent#True> .

