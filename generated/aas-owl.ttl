    skos:definition "A qualifier is a type-value-pair that makes additional statements w.r.t. the value of the element." ;
    skos:inScheme <https://admin-shell.io/aas/3/0/RC02> .

aas:RelationshipElement a owl:Class ;
    rdfs:label "RelationshipElement" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty aas:second ],
        [ a owl:Restriction ;
            owl:allValuesFrom aas:Reference ;
            owl:onProperty aas:second ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty aas:first ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty aas:first ],
        [ a owl:Restriction ;
            owl:allValuesFrom aas:Reference ;
            owl:onProperty aas:first ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty aas:second ],
        aas:SubmodelElement ;
    skos:definition "A relationship element is used to define a relationship between two elements being either referable (model reference) or external (global reference)." ;
    skos:inScheme <https://admin-shell.io/aas/3/0/RC02> .

