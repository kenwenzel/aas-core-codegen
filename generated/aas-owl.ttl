aas:Referable a owl:Class ;
    rdfs:label "Referable" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty aas:checksum ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty aas:description ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty aas:checksum ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty aas:category ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty aas:displayName ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty aas:idShort ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty aas:idShort ],
        [ a owl:Restriction ;
            owl:allValuesFrom rdf:langString ;
            owl:onProperty aas:description ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:intersectionOf ( xsd:string [ a rdfs:Datatype ;
                                owl:onDatatype xsd:string ;
                                owl:withRestrictions ( [ xsd:pattern "^[a-zA-Z][a-zA-Z0-9_]+$" ] ) ] ) ] ;
            owl:onProperty aas:idShort ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty aas:category ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty aas:category ],
        [ a owl:Restriction ;
            owl:allValuesFrom rdf:langString ;
            owl:onProperty aas:displayName ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty aas:checksum ],
        aas:HasExtensions ;
    skos:definition "An element that is referable by its 'idShort'." ;
    skos:inScheme <https://admin-shell.io/aas/3/0/RC02> .

<https://admin-shell.io/aas/3/0/RC02/ReferenceTypes#GlobalReference> a owl:Class ;
    rdfs:label "GlobalReference" ;
