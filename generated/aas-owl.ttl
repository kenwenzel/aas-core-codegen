aas:Reference a owl:Class ;
    rdfs:label "Reference" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty aas:referredSemanticId ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty aas:referredSemanticId ],
        [ a owl:Restriction ;
            owl:allValuesFrom aas:Reference ;
            owl:onProperty aas:referredSemanticId ],
        [ a owl:Restriction ;
            owl:allValuesFrom aas:ReferenceTypes ;
            owl:onProperty aas:type ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty aas:type ],
        [ a owl:Restriction ;
            owl:allValuesFrom aas:Key ;
            owl:onProperty aas:keys ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty aas:type ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty aas:keys ] ;
    skos:definition "Reference to either a model element of the same or another AAS or to an external entity." ;
    skos:inScheme <https://admin-shell.io/aas/3/0/RC02> .

