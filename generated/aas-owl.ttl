    skos:inScheme <https://admin-shell.io/aas/3/0/RC02> .

aas:minInterval a owl:DatatypeProperty ;
    rdfs:label "minInterval" ;
    skos:definition "For input direction, reports on the maximum frequency, the software entity behind the respective Referable can handle input events." ;
    skos:inScheme <https://admin-shell.io/aas/3/0/RC02> .

aas:nistName a owl:DatatypeProperty ;
    rdfs:label "nistName" ;
    skos:definition "Name of NIST physical unit" ;
