aas:siNotation a owl:DatatypeProperty ;
    rdfs:label "siNotation" ;
    skos:definition "Notation of SI physical unit" ;
    skos:inScheme <https://admin-shell.io/aas/3/0/RC02> .

aas:source a owl:ObjectProperty ;
