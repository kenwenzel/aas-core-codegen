aas:SubmodelElement a owl:Class ;
    rdfs:label "SubmodelElement" ;
    rdfs:subClassOf aas:HasDataSpecification,
        aas:HasKind,
        aas:HasSemantics,
        aas:Qualifiable,
        aas:Referable ;
    skos:definition "A submodel element is an element suitable for the description and differentiation of assets." ;
    skos:inScheme <https://admin-shell.io/aas/3/0/RC02> .

