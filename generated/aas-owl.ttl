aas:definition a owl:DatatypeProperty .

aas:submodels a owl:ObjectProperty .

aas:HasDataSpecification a owl:Class ;
    rdfs:label "HasDataSpecification" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom aas:EmbeddedDataSpecification ;
            owl:onProperty aas:embeddedDataSpecifications ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty aas:embeddedDataSpecifications ] ;
    skos:definition "Element that can be extended by using data specification templates." ;
    skos:inScheme <https://admin-shell.io/aas/3/0/RC02> .

aas:HasSemantics a owl:Class ;
    rdfs:label "HasSemantics" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom aas:Reference ;
            owl:onProperty aas:semanticId ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty aas:semanticId ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty aas:semanticId ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty aas:supplementalSemanticIds ],
        [ a owl:Restriction ;
            owl:allValuesFrom aas:Reference ;
            owl:onProperty aas:supplementalSemanticIds ] ;
    skos:definition "Element that can have a semantic definition plus some supplemental semantic definitions." ;
    skos:inScheme <https://admin-shell.io/aas/3/0/RC02> .

