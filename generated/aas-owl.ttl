aas:AssetKind a owl:Class ;
    owl:unionOf ( <https://admin-shell.io/aas/3/0/RC02/AssetKind#Type> <https://admin-shell.io/aas/3/0/RC02/AssetKind#Instance> ) ;
    linkml:permissible_values <https://admin-shell.io/aas/3/0/RC02/AssetKind#Instance>,
        <https://admin-shell.io/aas/3/0/RC02/AssetKind#Type> .

aas:DataSpecificationContent a owl:Class ;
    rdfs:label "DataSpecificationContent" ;
    skos:definition "Data specification content is part of a data specification template and defines which additional attributes shall be added to the element instance that references the data specification template and meta information about the template itself." ;
    skos:inScheme <https://admin-shell.io/aas/3/0/RC02> .

aas:Direction a owl:Class ;
    owl:unionOf ( <https://admin-shell.io/aas/3/0/RC02/Direction#Input> <https://admin-shell.io/aas/3/0/RC02/Direction#Output> ) ;
    linkml:permissible_values <https://admin-shell.io/aas/3/0/RC02/Direction#Input>,
        <https://admin-shell.io/aas/3/0/RC02/Direction#Output> .

aas:EntityType a owl:Class ;
    owl:unionOf ( <https://admin-shell.io/aas/3/0/RC02/EntityType#CoManagedEntity> <https://admin-shell.io/aas/3/0/RC02/EntityType#SelfManagedEntity> ) ;
    linkml:permissible_values <https://admin-shell.io/aas/3/0/RC02/EntityType#CoManagedEntity>,
        <https://admin-shell.io/aas/3/0/RC02/EntityType#SelfManagedEntity> .

aas:Identifiable a owl:Class ;
    rdfs:label "Identifiable" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty aas:id ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty aas:administration ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty aas:id ],
        [ a owl:Restriction ;
            owl:allValuesFrom aas:AdministrativeInformation ;
            owl:onProperty aas:administration ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty aas:administration ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty aas:id ],
        aas:Referable ;
    skos:definition "An element that has a globally unique identifier." ;
    skos:inScheme <https://admin-shell.io/aas/3/0/RC02> .

aas:ModelingKind a owl:Class ;
    owl:unionOf ( <https://admin-shell.io/aas/3/0/RC02/ModelingKind#Template> <https://admin-shell.io/aas/3/0/RC02/ModelingKind#Instance> ) ;
