aas:specificAssetIds a owl:ObjectProperty ;
    rdfs:label "specificAssetIds" ;
    skos:definition "Additional domain-specific, typically proprietary identifier for the asset like e.g., serial number etc." ;
    skos:inScheme <https://admin-shell.io/aas/3/0/RC02> .

aas:statements a owl:ObjectProperty ;
    rdfs:label "statements" ;
    skos:definition "Describes statements applicable to the entity by a set of submodel elements, typically with a qualified value." ;
    skos:inScheme <https://admin-shell.io/aas/3/0/RC02> .

aas:submodelElements a owl:ObjectProperty ;
    rdfs:label "submodelElements" ;
    skos:definition "A submodel consists of zero or more submodel elements." ;
