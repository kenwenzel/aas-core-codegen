aas:messageBroker a owl:ObjectProperty ;
    rdfs:label "messageBroker" ;
    skos:definition "Information, which outer message infrastructure shall handle messages for the 'EventElement'. Refers to a 'Submodel', 'SubmodelElementList', 'SubmodelElementCollection' or 'Entity', which contains 'DataElement''s describing the proprietary specification for the message broker." ;
    skos:inScheme <https://admin-shell.io/aas/3/0/RC02> .

aas:messageTopic a owl:DatatypeProperty ;
    rdfs:label "messageTopic" ;
    skos:definition "Information for the outer message infrastructure for scheduling the event to the respective communication channel." ;
    skos:inScheme <https://admin-shell.io/aas/3/0/RC02> .

