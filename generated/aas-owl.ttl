        aas:HasDataSpecification,
        aas:HasKind,
        aas:HasSemantics,
        aas:Identifiable,
        aas:Qualifiable ;
    skos:definition "A submodel defines a specific aspect of the asset represented by the AAS." ;
    skos:inScheme <https://admin-shell.io/aas/3/0/RC02> .

aas:ValueList a owl:Class ;
    rdfs:label "ValueList" ;
    rdfs:subClassOf [ a owl:Restriction ;
