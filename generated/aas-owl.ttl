    skos:inScheme <https://admin-shell.io/aas/3/0/RC02> .

aas:id a owl:DatatypeProperty ;
    rdfs:label "id" ;
    skos:definition "The globally unique identification of the element." ;
    skos:inScheme <https://admin-shell.io/aas/3/0/RC02> .

aas:idShort a owl:DatatypeProperty ;
    rdfs:label "idShort" ;
    skos:definition "In case of identifiables this attribute is a short name of the element. In case of referable this ID is an identifying string of the element within its name space." ;
    skos:inScheme <https://admin-shell.io/aas/3/0/RC02> .

aas:lastUpdate a owl:DatatypeProperty ;
    rdfs:label "lastUpdate" ;
    skos:definition "Timestamp in UTC, when the last event was received (input direction) or sent (output direction)." ;
    skos:inScheme <https://admin-shell.io/aas/3/0/RC02> .

aas:levelType a owl:ObjectProperty ;
