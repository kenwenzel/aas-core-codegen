aas:Qualifiable a owl:Class ;
    rdfs:label "Qualifiable" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty aas:qualifiers ],
        [ a owl:Restriction ;
            owl:allValuesFrom aas:Qualifier ;
            owl:onProperty aas:qualifiers ] ;
    skos:definition "The value of a qualifiable element may be further qualified by one or more qualifiers." ;
    skos:inScheme <https://admin-shell.io/aas/3/0/RC02> .

<https://admin-shell.io/aas/3/0/RC02/QualifierKind#ConceptQualifier> a owl:Class ;
    rdfs:label "ConceptQualifier" ;
    rdfs:subClassOf aas:QualifierKind .

