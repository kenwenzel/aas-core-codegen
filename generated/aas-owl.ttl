aas:SpecificAssetId a owl:Class ;
    rdfs:label "SpecificAssetId" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty aas:name ],
        [ a owl:Restriction ;
            owl:allValuesFrom aas:Reference ;
            owl:onProperty aas:externalSubjectId ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty aas:externalSubjectId ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty aas:value ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty aas:name ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty aas:value ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty aas:name ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty aas:externalSubjectId ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty aas:value ],
        aas:HasSemantics ;
    skos:definition "A specific asset ID describes a generic supplementary identifying attribute of the asset." ;
    skos:inScheme <https://admin-shell.io/aas/3/0/RC02> .

