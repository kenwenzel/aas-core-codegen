aas:ValueReferencePair a owl:Class ;
    rdfs:label "ValueReferencePair" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty aas:valueId ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty aas:value ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty aas:valueId ],
        [ a owl:Restriction ;
            owl:allValuesFrom aas:Reference ;
            owl:onProperty aas:valueId ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty aas:value ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty aas:value ] ;
    skos:definition "A value reference pair within a value list. Each value has a global unique id defining its semantic." ;
    skos:inScheme <https://admin-shell.io/aas/3/0/RC02> .

