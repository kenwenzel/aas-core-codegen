aas:entityType a owl:ObjectProperty ;
    rdfs:label "entityType" ;
    skos:definition "Describes whether the entity is a co-managed entity or a self-managed entity." ;
    skos:inScheme <https://admin-shell.io/aas/3/0/RC02> .

aas:externalSubjectId a owl:ObjectProperty ;
    rdfs:label "externalSubjectId" ;
