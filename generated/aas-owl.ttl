aas:max a owl:DatatypeProperty ;
    rdfs:label "max" ;
    skos:definition "The maximum value of the range." ;
    skos:inScheme <https://admin-shell.io/aas/3/0/RC02> .

aas:maxInterval a owl:DatatypeProperty ;
    rdfs:label "maxInterval" ;
