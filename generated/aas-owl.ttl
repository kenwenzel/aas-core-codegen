    rdfs:label "registrationAuthorityId" ;
    skos:definition "Registration authority ID" ;
    skos:inScheme <https://admin-shell.io/aas/3/0/RC02> .

aas:revision a owl:DatatypeProperty ;
    rdfs:label "revision" ;
    skos:definition "Revision of the element." ;
    skos:inScheme <https://admin-shell.io/aas/3/0/RC02> .

aas:second a owl:ObjectProperty ;
    rdfs:label "second" ;
    skos:definition "Reference to the second element in the relationship taking the role of the object." ;
    skos:inScheme <https://admin-shell.io/aas/3/0/RC02> .

aas:semanticId a owl:ObjectProperty ;
    rdfs:label "semanticId" ;
    skos:definition "Identifier of the semantic definition of the element. It is called semantic ID of the element or also main semantic ID of the element." ;
    skos:inScheme <https://admin-shell.io/aas/3/0/RC02> .

aas:semanticIdListElement a owl:ObjectProperty ;
    rdfs:label "semanticIdListElement" ;
    skos:definition "Semantic ID the submodel elements contained in the list match to." ;
    skos:inScheme <https://admin-shell.io/aas/3/0/RC02> .

aas:siName a owl:DatatypeProperty ;
    rdfs:label "siName" ;
    skos:definition "Name of SI physical unit" ;
