    rdfs:label "DataElement" ;
    rdfs:subClassOf aas:SubmodelElement ;
    skos:definition "A data element is a submodel element that is not further composed out of other submodel elements." ;
    skos:inScheme <https://admin-shell.io/aas/3/0/RC02> .

