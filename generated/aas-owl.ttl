aas:Entity a owl:Class ;
    rdfs:label "Entity" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom aas:EntityType ;
            owl:onProperty aas:entityType ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty aas:statements ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty aas:globalAssetId ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty aas:entityType ],
        [ a owl:Restriction ;
            owl:allValuesFrom aas:Reference ;
            owl:onProperty aas:globalAssetId ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty aas:specificAssetId ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty aas:entityType ],
        [ a owl:Restriction ;
            owl:allValuesFrom aas:SpecificAssetId ;
            owl:onProperty aas:specificAssetId ],
        [ a owl:Restriction ;
            owl:allValuesFrom aas:SubmodelElement ;
            owl:onProperty aas:statements ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty aas:specificAssetId ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty aas:globalAssetId ],
        aas:SubmodelElement ;
    skos:definition "An entity is a submodel element that is used to model entities." ;
    skos:inScheme <https://admin-shell.io/aas/3/0/RC02> .

aas:Environment a owl:Class ;
    rdfs:label "Environment" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty aas:submodels ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty aas:conceptDescriptions ],
        [ a owl:Restriction ;
            owl:allValuesFrom aas:AssetAdministrationShell ;
            owl:onProperty aas:assetAdministrationShells ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty aas:assetAdministrationShells ],
        [ a owl:Restriction ;
            owl:allValuesFrom aas:Submodel ;
            owl:onProperty aas:submodels ],
        [ a owl:Restriction ;
            owl:allValuesFrom aas:ConceptDescription ;
            owl:onProperty aas:conceptDescriptions ] ;
    skos:definition "Container for the sets of different identifiables." ;
    skos:inScheme <https://admin-shell.io/aas/3/0/RC02> .

aas:EventPayload a owl:Class ;
    rdfs:label "EventPayload" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom aas:Reference ;
            owl:onProperty aas:source ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty aas:observableReference ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty aas:source ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty aas:source ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty aas:timeStamp ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty aas:payload ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty aas:observableReference ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty aas:payload ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty aas:payload ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty aas:sourceSemanticId ],
        [ a owl:Restriction ;
            owl:allValuesFrom aas:Reference ;
            owl:onProperty aas:sourceSemanticId ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty aas:topic ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:intersectionOf ( xsd:string [ a rdfs:Datatype ;
                                owl:onDatatype xsd:string ;
                                owl:withRestrictions ( [ xsd:pattern "^-?(([1-9][0-9][0-9][0-9]+)|(0[0-9][0-9][0-9]))-((0[1-9])|(1[0-2]))-((0[1-9])|([12][0-9])|(3[01]))T(((([01][0-9])|(2[0-3])):[0-5][0-9]:([0-5][0-9])(\\.[0-9]+)?)|24:00:00(\\.0+)?)Z$" ] ) ] ) ] ;
            owl:onProperty aas:timeStamp ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty aas:subjectId ],
        [ a owl:Restriction ;
            owl:allValuesFrom aas:Reference ;
            owl:onProperty aas:observableReference ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty aas:topic ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty aas:sourceSemanticId ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty aas:observableSemanticId ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty aas:subjectId ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty aas:timeStamp ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty aas:observableSemanticId ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty aas:topic ],
        [ a owl:Restriction ;
            owl:allValuesFrom aas:Reference ;
            owl:onProperty aas:subjectId ],
        [ a owl:Restriction ;
            owl:allValuesFrom aas:Reference ;
            owl:onProperty aas:observableSemanticId ] ;
    skos:definition "Defines the necessary information of an event instance sent out or received." ;
    skos:inScheme <https://admin-shell.io/aas/3/0/RC02> .

aas:File a owl:Class ;
    rdfs:label "File" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty aas:contentType ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty aas:value ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty aas:value ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:intersectionOf ( xsd:string [ a rdfs:Datatype ;
                                owl:onDatatype xsd:string ;
