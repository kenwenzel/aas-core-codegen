            sh:maxCount 1 ;
            sh:order 10 ;
            sh:path aas:kind ],
        [ sh:description "The submodel element type of the submodel elements contained in the list." ;
            sh:in ( "AnnotatedRelationshipElement" "BasicEventElement" "Blob" "Capability" "DataElement" "Entity" "EventElement" "File" "MultiLanguageProperty" "Operation" "Property" "Range" "ReferenceElement" "RelationshipElement" "SubmodelElement" "SubmodelElementList" "SubmodelElementCollection" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 2 ;
            sh:path aas:typeValueListElement ],
        [ sh:datatype rdf:langString ;
            sh:description "Display name. Can be provided in several languages." ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path aas:displayName ],
        [ sh:class aas:Reference ;
            sh:description "Semantic ID the submodel elements contained in the list match to." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path aas:semanticIdListElement ],
        [ sh:class aas:Extension ;
            sh:description "An extension of the element." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 15 ;
            sh:path aas:extensions ],
        [ sh:class aas:SubmodelElement ;
            sh:description "Submodel element contained in the list." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path aas:value ],
        [ sh:class aas:Reference ;
            sh:description "Identifier of a supplemental semantic definition of the element. It is called supplemental semantic ID of the element." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 12 ;
            sh:path aas:supplementalSemanticIds ],
        [ sh:class aas:EmbeddedDataSpecification ;
            sh:description "Embedded data specification." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 14 ;
            sh:path aas:embeddedDataSpecifications ],
        [ sh:description "The value type of the submodel element contained in the list." ;
            sh:in ( "AnyUri" "Base64Binary" "Boolean" "Date" "DateTime" "DateTimeStamp" "Decimal" "Double" "Duration" "Float" "GDay" "GMonth" "GMonthDay" "GYear" "GYearMonth" "HexBinary" "String" "Time" "DayTimeDuration" "YearMonthDuration" "Integer" "Long" "Int" "Short" "Byte" "NonNegativeInteger" "PositiveInteger" "UnsignedLong" "UnsignedInt" "UnsignedShort" "UnsignedByte" "NonPositiveInteger" "NegativeInteger" ) ;
            sh:maxCount 1 ;
            sh:order 4 ;
            sh:path aas:valueTypeListElement ],
        [ sh:datatype xsd:string ;
            sh:description "In case of identifiables this attribute is a short name of the element. In case of referable this ID is an identifying string of the element within its name space." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path aas:idShort ;
            sh:pattern "^[a-zA-Z][a-zA-Z0-9_]+$" ],
        [ sh:class aas:Qualifier ;
            sh:description "Additional qualification of a qualifiable element." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 13 ;
            sh:path aas:qualifiers ],
        [ sh:datatype xsd:boolean ;
            sh:description "Defines whether order in list is relevant. If 'orderRelevant' = False then the list is representing a set or a bag." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path aas:orderRelevant ],
        [ sh:datatype xsd:string ;
            sh:description "The category is a value that gives further meta information w.r.t. to the class of the element. It affects the expected existence of attributes and the applicability of constraints." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path aas:category ],
        [ sh:datatype rdf:langString ;
            sh:description "Description or comments on the element." ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path aas:description ] ;
    sh:targetClass aas:SubmodelElementList .

aas:AssetAdministrationShell a sh:NodeShape ;
    sh:closed true ;
    sh:description "An asset administration shell." ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "In case of identifiables this attribute is a short name of the element. In case of referable this ID is an identifying string of the element within its name space." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 10 ;
            sh:path aas:idShort ;
            sh:pattern "^[a-zA-Z][a-zA-Z0-9_]+$" ],
        [ sh:datatype rdf:langString ;
            sh:description "Description or comments on the element." ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path aas:description ],
        [ sh:class aas:Reference ;
            sh:description "The reference to the AAS the AAS was derived from." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path aas:derivedFrom ],
        [ sh:class aas:Reference ;
            sh:description "References to submodels of the AAS." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path aas:submodels ],
        [ sh:datatype xsd:string ;
            sh:description "Checksum to be used to determine if an Referable (including its aggregated child elements) has changed." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path aas:checksum ],
        [ sh:class aas:AdministrativeInformation ;
            sh:description "Administrative information of an identifiable element." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path aas:administration ],
        [ sh:class aas:AssetInformation ;
            sh:description "Meta-information about the asset the AAS is representing." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path aas:assetInformation ],
        [ sh:datatype xsd:string ;
            sh:description "The globally unique identification of the element." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path aas:id ],
        [ sh:datatype rdf:langString ;
            sh:description "Display name. Can be provided in several languages." ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path aas:displayName ],
        [ sh:datatype xsd:string ;
            sh:description "The category is a value that gives further meta information w.r.t. to the class of the element. It affects the expected existence of attributes and the applicability of constraints." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path aas:category ],
        [ sh:class aas:EmbeddedDataSpecification ;
            sh:description "Embedded data specification." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path aas:embeddedDataSpecifications ],
        [ sh:class aas:Extension ;
            sh:description "An extension of the element." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 11 ;
            sh:path aas:extensions ] ;
    sh:targetClass aas:AssetAdministrationShell .

aas:AssetInformation a sh:NodeShape ;
    sh:closed true ;
    sh:description "In 'AssetInformation' identifying meta data of the asset that is represented by an AAS is defined." ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:description "Denotes whether the Asset is of kind 'Type' or 'Instance'." ;
            sh:in ( "Type" "Instance" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 0 ;
            sh:path aas:assetKind ],
        [ sh:class aas:Reference ;
            sh:description "Global identifier of the asset the AAS is representing." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path aas:globalAssetId ],
        [ sh:class aas:SpecificAssetId ;
            sh:description "Additional domain-specific, typically proprietary identifier for the asset like e.g., serial number etc." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path aas:specificAssetIds ],
        [ sh:class aas:Resource ;
            sh:description "Thumbnail of the asset represented by the Asset Administration Shell." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path aas:defaultThumbnail ] ;
    sh:targetClass aas:AssetInformation .

aas:ConceptDescription a sh:NodeShape ;
    sh:closed true ;
    sh:description "The semantics of a property or other elements that may have a semantic description is defined by a concept description." ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Checksum to be used to determine if an Referable (including its aggregated child elements) has changed." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path aas:checksum ],
        [ sh:datatype xsd:string ;
            sh:description "The globally unique identification of the element." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path aas:id ],
        [ sh:datatype rdf:langString ;
            sh:description "Description or comments on the element." ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path aas:description ],
        [ sh:datatype xsd:string ;
            sh:description "The category is a value that gives further meta information w.r.t. to the class of the element. It affects the expected existence of attributes and the applicability of constraints." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path aas:category ],
        [ sh:class aas:Reference ;
            sh:description "Reference to an external definition the concept is compatible to or was derived from." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path aas:isCaseOf ],
        [ sh:datatype xsd:string ;
            sh:description "In case of identifiables this attribute is a short name of the element. In case of referable this ID is an identifying string of the element within its name space." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path aas:idShort ;
            sh:pattern "^[a-zA-Z][a-zA-Z0-9_]+$" ],
        [ sh:class aas:EmbeddedDataSpecification ;
            sh:description "Embedded data specification." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path aas:embeddedDataSpecifications ],
        [ sh:class aas:Extension ;
            sh:description "An extension of the element." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 9 ;
            sh:path aas:extensions ],
        [ sh:datatype rdf:langString ;
            sh:description "Display name. Can be provided in several languages." ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path aas:displayName ],
        [ sh:class aas:AdministrativeInformation ;
            sh:description "Administrative information of an identifiable element." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path aas:administration ] ;
    sh:targetClass aas:ConceptDescription .

aas:DataElement a sh:NodeShape ;
    sh:closed false ;
    sh:description "A data element is a submodel element that is not further composed out of other submodel elements." ;
    sh:ignoredProperties ( aas:value aas:valueId aas:max aas:valueType aas:contentType rdf:type aas:min ) ;
    sh:property [ sh:datatype rdf:langString ;
            sh:description "Description or comments on the element." ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path aas:description ],
        [ sh:datatype xsd:string ;
            sh:description "Checksum to be used to determine if an Referable (including its aggregated child elements) has changed." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path aas:checksum ],
        [ sh:datatype rdf:langString ;
            sh:description "Display name. Can be provided in several languages." ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path aas:displayName ],
        [ sh:description "Kind of the element: either type or instance." ;
            sh:in ( "Template" "Instance" ) ;
            sh:maxCount 1 ;
            sh:order 5 ;
            sh:path aas:kind ],
        [ sh:class aas:Reference ;
            sh:description "Identifier of a supplemental semantic definition of the element. It is called supplemental semantic ID of the element." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 7 ;
            sh:path aas:supplementalSemanticIds ],
        [ sh:datatype xsd:string ;
            sh:description "The category is a value that gives further meta information w.r.t. to the class of the element. It affects the expected existence of attributes and the applicability of constraints." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path aas:category ],
        [ sh:class aas:Qualifier ;
            sh:description "Additional qualification of a qualifiable element." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 8 ;
            sh:path aas:qualifiers ],
        [ sh:class aas:Reference ;
            sh:description "Identifier of the semantic definition of the element. It is called semantic ID of the element or also main semantic ID of the element." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 6 ;
            sh:path aas:semanticId ],
        [ sh:class aas:EmbeddedDataSpecification ;
            sh:description "Embedded data specification." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 9 ;
            sh:path aas:embeddedDataSpecifications ],
        [ sh:datatype xsd:string ;
            sh:description "In case of identifiables this attribute is a short name of the element. In case of referable this ID is an identifying string of the element within its name space." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path aas:idShort ;
            sh:pattern "^[a-zA-Z][a-zA-Z0-9_]+$" ],
        [ sh:class aas:Extension ;
            sh:description "An extension of the element." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 10 ;
            sh:path aas:extensions ] ;
    sh:targetClass aas:DataElement .

aas:DataSpecificationContent a sh:NodeShape ;
    sh:closed false ;
    sh:description "Data specification content is part of a data specification template and defines which additional attributes shall be added to the element instance that references the data specification template and meta information about the template itself." ;
    sh:ignoredProperties ( aas:value aas:siNotation aas:unitId aas:dinNotation aas:registrationAuthorityId aas:supplier aas:levelType aas:sourceOfDefinition aas:unitSymbol aas:eceCode aas:valueFormat aas:valueList aas:symbol rdf:type aas:unitName aas:siName aas:definition aas:dataType aas:unit aas:shortName aas:eceName aas:nistName aas:preferredName aas:conversionFactor ) ;
    sh:targetClass aas:DataSpecificationContent .

aas:Key a sh:NodeShape ;
    sh:closed true ;
    sh:description "A key is a reference to an element by its ID." ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "The key value, for example an IRDI or an URI" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path aas:value ],
        [ sh:description "Denotes which kind of entity is referenced." ;
            sh:in ( "FragmentReference" "GlobalReference" "AnnotatedRelationshipElement" "AssetAdministrationShell" "BasicEventElement" "Blob" "Capability" "ConceptDescription" "Identifiable" "DataElement" "Entity" "EventElement" "File" "MultiLanguageProperty" "Operation" "Property" "Range" "ReferenceElement" "Referable" "RelationshipElement" "Submodel" "SubmodelElement" "SubmodelElementList" "SubmodelElementCollection" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 0 ;
            sh:path aas:type ] ;
    sh:targetClass aas:Key .

aas:Resource a sh:NodeShape ;
    sh:closed true ;
    sh:description "Resource represents an address to a file (a locator). The value is an URI that can represent an absolute or relative path" ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Content type of the content of the file." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path aas:contentType ;
            sh:pattern "^([!#$%&'*+\\-.^_`|~0-9a-zA-Z])+/([!#$%&'*+\\-.^_`|~0-9a-zA-Z])+([ \\t]*;[ \\t]*([!#$%&'*+\\-.^_`|~0-9a-zA-Z])+=(([!#$%&'*+\\-.^_`|~0-9a-zA-Z])+|\"(([\\t !#-\\[\\]-~]|[\\x80-\\xff])|\\\\([\\t !-~]|[\\x80-\\xff]))*\"))*$" ],
        [ sh:datatype xsd:string ;
            sh:description "Path and name of the resource (with file extension)." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path aas:path ;
            sh:pattern "^file:(//((localhost|(\\[((([0-9A-Fa-f]{1,4}:){6}([0-9A-Fa-f]{1,4}:[0-9A-Fa-f]{1,4}|([0-9]|[1-9][0-9]|1[0-9]{2}|2[0-4][0-9]|25[0-5])\\.([0-9]|[1-9][0-9]|1[0-9]{2}|2[0-4][0-9]|25[0-5])\\.([0-9]|[1-9][0-9]|1[0-9]{2}|2[0-4][0-9]|25[0-5])\\.([0-9]|[1-9][0-9]|1[0-9]{2}|2[0-4][0-9]|25[0-5]))|::([0-9A-Fa-f]{1,4}:){5}([0-9A-Fa-f]{1,4}:[0-9A-Fa-f]{1,4}|([0-9]|[1-9][0-9]|1[0-9]{2}|2[0-4][0-9]|25[0-5])\\.([0-9]|[1-9][0-9]|1[0-9]{2}|2[0-4][0-9]|25[0-5])\\.([0-9]|[1-9][0-9]|1[0-9]{2}|2[0-4][0-9]|25[0-5])\\.([0-9]|[1-9][0-9]|1[0-9]{2}|2[0-4][0-9]|25[0-5]))|([0-9A-Fa-f]{1,4})?::([0-9A-Fa-f]{1,4}:){4}([0-9A-Fa-f]{1,4}:[0-9A-Fa-f]{1,4}|([0-9]|[1-9][0-9]|1[0-9]{2}|2[0-4][0-9]|25[0-5])\\.([0-9]|[1-9][0-9]|1[0-9]{2}|2[0-4][0-9]|25[0-5])\\.([0-9]|[1-9][0-9]|1[0-9]{2}|2[0-4][0-9]|25[0-5])\\.([0-9]|[1-9][0-9]|1[0-9]{2}|2[0-4][0-9]|25[0-5]))|(([0-9A-Fa-f]{1,4}:)?[0-9A-Fa-f]{1,4})?::([0-9A-Fa-f]{1,4}:){3}([0-9A-Fa-f]{1,4}:[0-9A-Fa-f]{1,4}|([0-9]|[1-9][0-9]|1[0-9]{2}|2[0-4][0-9]|25[0-5])\\.([0-9]|[1-9][0-9]|1[0-9]{2}|2[0-4][0-9]|25[0-5])\\.([0-9]|[1-9][0-9]|1[0-9]{2}|2[0-4][0-9]|25[0-5])\\.([0-9]|[1-9][0-9]|1[0-9]{2}|2[0-4][0-9]|25[0-5]))|(([0-9A-Fa-f]{1,4}:){2}[0-9A-Fa-f]{1,4})?::([0-9A-Fa-f]{1,4}:){2}([0-9A-Fa-f]{1,4}:[0-9A-Fa-f]{1,4}|([0-9]|[1-9][0-9]|1[0-9]{2}|2[0-4][0-9]|25[0-5])\\.([0-9]|[1-9][0-9]|1[0-9]{2}|2[0-4][0-9]|25[0-5])\\.([0-9]|[1-9][0-9]|1[0-9]{2}|2[0-4][0-9]|25[0-5])\\.([0-9]|[1-9][0-9]|1[0-9]{2}|2[0-4][0-9]|25[0-5]))|(([0-9A-Fa-f]{1,4}:){3}[0-9A-Fa-f]{1,4})?::[0-9A-Fa-f]{1,4}:([0-9A-Fa-f]{1,4}:[0-9A-Fa-f]{1,4}|([0-9]|[1-9][0-9]|1[0-9]{2}|2[0-4][0-9]|25[0-5])\\.([0-9]|[1-9][0-9]|1[0-9]{2}|2[0-4][0-9]|25[0-5])\\.([0-9]|[1-9][0-9]|1[0-9]{2}|2[0-4][0-9]|25[0-5])\\.([0-9]|[1-9][0-9]|1[0-9]{2}|2[0-4][0-9]|25[0-5]))|(([0-9A-Fa-f]{1,4}:){4}[0-9A-Fa-f]{1,4})?::([0-9A-Fa-f]{1,4}:[0-9A-Fa-f]{1,4}|([0-9]|[1-9][0-9]|1[0-9]{2}|2[0-4][0-9]|25[0-5])\\.([0-9]|[1-9][0-9]|1[0-9]{2}|2[0-4][0-9]|25[0-5])\\.([0-9]|[1-9][0-9]|1[0-9]{2}|2[0-4][0-9]|25[0-5])\\.([0-9]|[1-9][0-9]|1[0-9]{2}|2[0-4][0-9]|25[0-5]))|(([0-9A-Fa-f]{1,4}:){5}[0-9A-Fa-f]{1,4})?::[0-9A-Fa-f]{1,4}|(([0-9A-Fa-f]{1,4}:){6}[0-9A-Fa-f]{1,4})?::)|[vV][0-9A-Fa-f]+\\.([a-zA-Z0-9\\-._~]|[!$&'()*+,;=]|:)+)\\]|([0-9]|[1-9][0-9]|1[0-9]{2}|2[0-4][0-9]|25[0-5])\\.([0-9]|[1-9][0-9]|1[0-9]{2}|2[0-4][0-9]|25[0-5])\\.([0-9]|[1-9][0-9]|1[0-9]{2}|2[0-4][0-9]|25[0-5])\\.([0-9]|[1-9][0-9]|1[0-9]{2}|2[0-4][0-9]|25[0-5])|([a-zA-Z0-9\\-._~]|%[0-9A-Fa-f][0-9A-Fa-f]|[!$&'()*+,;=])*)))?/((([a-zA-Z0-9\\-._~]|%[0-9A-Fa-f][0-9A-Fa-f]|[!$&'()*+,;=]|[:@]))+(/(([a-zA-Z0-9\\-._~]|%[0-9A-Fa-f][0-9A-Fa-f]|[!$&'()*+,;=]|[:@]))*)*)?|/((([a-zA-Z0-9\\-._~]|%[0-9A-Fa-f][0-9A-Fa-f]|[!$&'()*+,;=]|[:@]))+(/(([a-zA-Z0-9\\-._~]|%[0-9A-Fa-f][0-9A-Fa-f]|[!$&'()*+,;=]|[:@]))*)*)?)$" ] ;
    sh:targetClass aas:Resource .

aas:Submodel a sh:NodeShape ;
    sh:closed true ;
    sh:description "A submodel defines a specific aspect of the asset represented by the AAS." ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "The category is a value that gives further meta information w.r.t. to the class of the element. It affects the expected existence of attributes and the applicability of constraints." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path aas:category ],
        [ sh:datatype xsd:string ;
            sh:description "In case of identifiables this attribute is a short name of the element. In case of referable this ID is an identifying string of the element within its name space." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 12 ;
            sh:path aas:idShort ;
            sh:pattern "^[a-zA-Z][a-zA-Z0-9_]+$" ],
        [ sh:datatype rdf:langString ;
            sh:description "Display name. Can be provided in several languages." ;
            sh:nodeKind sh:Literal ;
            sh:order 11 ;
            sh:path aas:displayName ],
        [ sh:datatype xsd:string ;
            sh:description "The globally unique identification of the element." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path aas:id ],
        [ sh:class aas:EmbeddedDataSpecification ;
            sh:description "Embedded data specification." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 7 ;
            sh:path aas:embeddedDataSpecifications ],
        [ sh:class aas:Extension ;
            sh:description "An extension of the element." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 13 ;
            sh:path aas:extensions ],
        [ sh:class aas:Reference ;
            sh:description "Identifier of the semantic definition of the element. It is called semantic ID of the element or also main semantic ID of the element." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path aas:semanticId ],
        [ sh:datatype rdf:langString ;
            sh:description "Description or comments on the element." ;
            sh:nodeKind sh:Literal ;
            sh:order 10 ;
            sh:path aas:description ],
        [ sh:class aas:AdministrativeInformation ;
            sh:description "Administrative information of an identifiable element." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path aas:administration ],
        [ sh:description "Kind of the element: either type or instance." ;
            sh:in ( "Template" "Instance" ) ;
            sh:maxCount 1 ;
            sh:order 3 ;
            sh:path aas:kind ],
        [ sh:class aas:Qualifier ;
            sh:description "Additional qualification of a qualifiable element." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 6 ;
            sh:path aas:qualifiers ],
        [ sh:class aas:Reference ;
            sh:description "Identifier of a supplemental semantic definition of the element. It is called supplemental semantic ID of the element." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path aas:supplementalSemanticIds ],
        [ sh:datatype xsd:string ;
            sh:description "Checksum to be used to determine if an Referable (including its aggregated child elements) has changed." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path aas:checksum ],
        [ sh:class aas:SubmodelElement ;
            sh:description "A submodel consists of zero or more submodel elements." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path aas:submodelElements ] ;
    sh:targetClass aas:Submodel .

aas:ValueList a sh:NodeShape ;
    sh:closed true ;
    sh:description "A set of value reference pairs." ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class aas:ValueReferencePair ;
            sh:description "A pair of a value together with its global unique id." ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path aas:valueReferencePairs ] ;
    sh:targetClass aas:ValueList .

aas:ValueReferencePair a sh:NodeShape ;
    sh:closed true ;
    sh:description "A value reference pair within a value list. Each value has a global unique id defining its semantic." ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class aas:Reference ;
            sh:description "Global unique id of the value." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path aas:valueId ],
        [ sh:datatype xsd:string ;
            sh:description "The value of the referenced concept definition of the value in valueId." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path aas:value ] ;
    sh:targetClass aas:ValueReferencePair .

aas:SpecificAssetId a sh:NodeShape ;
    sh:closed true ;
    sh:description "A specific asset ID describes a generic supplementary identifying attribute of the asset." ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class aas:Reference ;
            sh:description "The (external) subject the key belongs to or has meaning to." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path aas:externalSubjectId ],
        [ sh:datatype xsd:string ;
            sh:description "Name of the identifier" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path aas:name ],
        [ sh:datatype xsd:string ;
            sh:description "The value of the specific asset identifier with the corresponding name." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path aas:value ],
        [ sh:class aas:Reference ;
            sh:description "Identifier of a supplemental semantic definition of the element. It is called supplemental semantic ID of the element." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path aas:supplementalSemanticIds ],
        [ sh:class aas:Reference ;
            sh:description "Identifier of the semantic definition of the element. It is called semantic ID of the element or also main semantic ID of the element." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path aas:semanticId ] ;
    sh:targetClass aas:SpecificAssetId .

aas:OperationVariable a sh:NodeShape ;
    sh:closed true ;
    sh:description "The value of an operation variable is a submodel element that is used as input and/or output variable of an operation." ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class aas:SubmodelElement ;
            sh:description "Describes an argument or result of an operation via a submodel element" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path aas:value ] ;
    sh:targetClass aas:OperationVariable .

aas:AdministrativeInformation a sh:NodeShape ;
    sh:closed true ;
    sh:description "Administrative meta-information for an element like version information." ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Version of the element." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path aas:version ],
        [ sh:datatype xsd:string ;
            sh:description "Revision of the element." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path aas:revision ],
        [ sh:class aas:EmbeddedDataSpecification ;
            sh:description "Embedded data specification." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path aas:embeddedDataSpecifications ] ;
    sh:targetClass aas:AdministrativeInformation .

aas:SubmodelElement a sh:NodeShape ;
    sh:closed false ;
    sh:description "A submodel element is an element suitable for the description and differentiation of assets." ;
    sh:ignoredProperties ( aas:valueTypeListElement aas:first aas:globalAssetId aas:messageBroker aas:contentType aas:direction aas:inoutputVariables aas:minInterval aas:second aas:statements aas:typeValueListElement aas:valueId aas:inputVariables aas:outputVariables aas:state aas:value aas:specificAssetId aas:semanticIdListElement aas:lastUpdate aas:messageTopic rdf:type aas:maxInterval aas:observed aas:min aas:annotations aas:max aas:valueType aas:orderRelevant aas:entityType ) ;
    sh:property [ sh:datatype rdf:langString ;
            sh:description "Description or comments on the element." ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path aas:description ],
        [ sh:class aas:Reference ;
            sh:description "Identifier of a supplemental semantic definition of the element. It is called supplemental semantic ID of the element." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 7 ;
            sh:path aas:supplementalSemanticIds ],
        [ sh:datatype xsd:string ;
            sh:description "Checksum to be used to determine if an Referable (including its aggregated child elements) has changed." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path aas:checksum ],
        [ sh:datatype rdf:langString ;
            sh:description "Display name. Can be provided in several languages." ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path aas:displayName ],
        [ sh:class aas:Extension ;
            sh:description "An extension of the element." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 10 ;
            sh:path aas:extensions ],
        [ sh:class aas:Reference ;
            sh:description "Identifier of the semantic definition of the element. It is called semantic ID of the element or also main semantic ID of the element." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 6 ;
            sh:path aas:semanticId ],
        [ sh:description "Kind of the element: either type or instance." ;
            sh:in ( "Template" "Instance" ) ;
            sh:maxCount 1 ;
            sh:order 5 ;
            sh:path aas:kind ],
        [ sh:datatype xsd:string ;
            sh:description "The category is a value that gives further meta information w.r.t. to the class of the element. It affects the expected existence of attributes and the applicability of constraints." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path aas:category ],
        [ sh:datatype xsd:string ;
            sh:description "In case of identifiables this attribute is a short name of the element. In case of referable this ID is an identifying string of the element within its name space." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path aas:idShort ;
            sh:pattern "^[a-zA-Z][a-zA-Z0-9_]+$" ],
        [ sh:class aas:EmbeddedDataSpecification ;
            sh:description "Embedded data specification." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 9 ;
            sh:path aas:embeddedDataSpecifications ],
        [ sh:class aas:Qualifier ;
            sh:description "Additional qualification of a qualifiable element." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 8 ;
            sh:path aas:qualifiers ] ;
    sh:targetClass aas:SubmodelElement .

aas:Qualifier a sh:NodeShape ;
    sh:closed true ;
    sh:description "A qualifier is a type-value-pair that makes additional statements w.r.t. the value of the element." ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:description "The qualifier kind describes the kind of the qualifier that is applied to the element." ;
            sh:in ( "ValueQualifier" "ConceptQualifier" "TemplateQualifier" ) ;
            sh:maxCount 1 ;
            sh:order 0 ;
            sh:path aas:kind ],
        [ sh:datatype xsd:string ;
            sh:description "The qualifier value is the value of the qualifier." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path aas:value ],
        [ sh:datatype xsd:string ;
            sh:description "The qualifier type describes the type of the qualifier that is applied to the element." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path aas:type ],
        [ sh:class aas:Reference ;
            sh:description "Identifier of the semantic definition of the element. It is called semantic ID of the element or also main semantic ID of the element." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path aas:semanticId ],
        [ sh:class aas:Reference ;
            sh:description "Reference to the global unique ID of a coded value." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path aas:valueId ],
        [ sh:description "Data type of the qualifier value." ;
            sh:in ( "AnyUri" "Base64Binary" "Boolean" "Date" "DateTime" "DateTimeStamp" "Decimal" "Double" "Duration" "Float" "GDay" "GMonth" "GMonthDay" "GYear" "GYearMonth" "HexBinary" "String" "Time" "DayTimeDuration" "YearMonthDuration" "Integer" "Long" "Int" "Short" "Byte" "NonNegativeInteger" "PositiveInteger" "UnsignedLong" "UnsignedInt" "UnsignedShort" "UnsignedByte" "NonPositiveInteger" "NegativeInteger" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 4 ;
            sh:path aas:valueType ],
        [ sh:class aas:Reference ;
            sh:description "Identifier of a supplemental semantic definition of the element. It is called supplemental semantic ID of the element." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 6 ;
            sh:path aas:supplementalSemanticIds ] ;
    sh:targetClass aas:Qualifier .

aas:EmbeddedDataSpecification a sh:NodeShape ;
    sh:closed true ;
    sh:description "Embed the content of a data specification." ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class aas:DataSpecificationContent ;
            sh:description "Actual content of the data specification" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path aas:dataSpecificationContent ],
        [ sh:class aas:Reference ;
            sh:description "Reference to the data specification" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path aas:dataSpecification ] ;
    sh:targetClass aas:EmbeddedDataSpecification .

aas:Extension a sh:NodeShape ;
    sh:closed true ;
    sh:description "Single extension of an element." ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Value of the extension" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path aas:value ],
        [ sh:class aas:Reference ;
            sh:description "Reference to an element the extension refers to." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path aas:refersTo ],
        [ sh:class aas:Reference ;
            sh:description "Identifier of a supplemental semantic definition of the element. It is called supplemental semantic ID of the element." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path aas:supplementalSemanticIds ],
        [ sh:class aas:Reference ;
            sh:description "Identifier of the semantic definition of the element. It is called semantic ID of the element or also main semantic ID of the element." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path aas:semanticId ],
        [ sh:datatype xsd:string ;
            sh:description "Name of the extension." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path aas:name ],
        [ sh:description "Type of the value of the extension." ;
            sh:in ( "AnyUri" "Base64Binary" "Boolean" "Date" "DateTime" "DateTimeStamp" "Decimal" "Double" "Duration" "Float" "GDay" "GMonth" "GMonthDay" "GYear" "GYearMonth" "HexBinary" "String" "Time" "DayTimeDuration" "YearMonthDuration" "Integer" "Long" "Int" "Short" "Byte" "NonNegativeInteger" "PositiveInteger" "UnsignedLong" "UnsignedInt" "UnsignedShort" "UnsignedByte" "NonPositiveInteger" "NegativeInteger" ) ;
            sh:maxCount 1 ;
            sh:order 3 ;
            sh:path aas:valueType ] ;
    sh:targetClass aas:Extension .

aas:Reference a sh:NodeShape ;
    sh:closed true ;
    sh:description "Reference to either a model element of the same or another AAS or to an external entity." ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:description "Type of the reference." ;
            sh:in ( "GlobalReference" "ModelReference" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 2 ;
            sh:path aas:type ],
        [ sh:class aas:Key ;
            sh:description "Unique references in their name space." ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path aas:keys ],
        [ sh:class aas:Reference ;
            sh:description "'semanticId' of the referenced model element ('type' = 'ModelReference')." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path aas:referredSemanticId ] ;
    sh:targetClass aas:Reference .


