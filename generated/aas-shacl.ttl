aas:RelationshipElement a sh:NodeShape ;
    sh:closed true ;
    sh:description "A relationship element is used to define a relationship between two elements being either referable (model reference) or external (global reference)." ;
    sh:ignoredProperties ( rdf:type aas:annotations ) ;
    sh:property [ sh:class aas:Reference ;
            sh:description "Identifier of a supplemental semantic definition of the element. It is called supplemental semantic ID of the element." ;
