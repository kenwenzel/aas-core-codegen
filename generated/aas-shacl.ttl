@prefix aas: <https://admin-shell.io/aas/3/0/RC02/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

aas:AnnotatedRelationshipElement a sh:NodeShape ;
    sh:closed true ;
    sh:description "An annotated relationship element is a relationship element that can be annotated with additional data elements." ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype rdf:langString ;
            sh:description "Description or comments on the element." ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path aas:description ],
        [ sh:datatype xsd:string ;
            sh:description "Checksum to be used to determine if an Referable (including its aggregated child elements) has changed." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path aas:checksum ],
        [ sh:class aas:EmbeddedDataSpecification ;
            sh:description "Embedded data specification." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 12 ;
            sh:path aas:embeddedDataSpecifications ],
        [ sh:class aas:Reference ;
            sh:description "Identifier of a supplemental semantic definition of the element. It is called supplemental semantic ID of the element." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 10 ;
            sh:path aas:supplementalSemanticIds ],
        [ sh:class aas:Reference ;
            sh:description "Reference to the first element in the relationship taking the role of the subject." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path aas:first ],
        [ sh:class aas:Reference ;
            sh:description "Identifier of the semantic definition of the element. It is called semantic ID of the element or also main semantic ID of the element." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 9 ;
            sh:path aas:semanticId ],
        [ sh:description "Kind of the element: either type or instance." ;
            sh:in ( "Template" "Instance" ) ;
            sh:maxCount 1 ;
            sh:order 8 ;
            sh:path aas:kind ],
        [ sh:class aas:DataElement ;
            sh:description "A data element that represents an annotation that holds for the relationship between the two elements" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path aas:annotations ],
        [ sh:datatype xsd:string ;
            sh:description "The category is a value that gives further meta information w.r.t. to the class of the element. It affects the expected existence of attributes and the applicability of constraints." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path aas:category ],
        [ sh:class aas:Extension ;
            sh:description "An extension of the element." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 13 ;
            sh:path aas:extensions ],
        [ sh:class aas:Qualifier ;
            sh:description "Additional qualification of a qualifiable element." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 11 ;
            sh:path aas:qualifiers ],
        [ sh:datatype rdf:langString ;
            sh:description "Display name. Can be provided in several languages." ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path aas:displayName ],
        [ sh:datatype xsd:string ;
            sh:description "In case of identifiables this attribute is a short name of the element. In case of referable this ID is an identifying string of the element within its name space." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path aas:idShort ;
            sh:pattern "^[a-zA-Z][a-zA-Z0-9_]+$" ],
        [ sh:class aas:Reference ;
            sh:description "Reference to the second element in the relationship taking the role of the object." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path aas:second ] ;
    sh:targetClass aas:AnnotatedRelationshipElement .

aas:BasicEventElement a sh:NodeShape ;
    sh:closed true ;
    sh:description "A basic event element." ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class aas:EmbeddedDataSpecification ;
            sh:description "Embedded data specification." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 17 ;
            sh:path aas:embeddedDataSpecifications ],
        [ sh:class aas:Qualifier ;
            sh:description "Additional qualification of a qualifiable element." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 16 ;
            sh:path aas:qualifiers ],
        [ sh:class aas:Reference ;
            sh:description "Information, which outer message infrastructure shall handle messages for the 'EventElement'. Refers to a 'Submodel', 'SubmodelElementList', 'SubmodelElementCollection' or 'Entity', which contains 'DataElement''s describing the proprietary specification for the message broker." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path aas:messageBroker ],
        [ sh:datatype xsd:string ;
            sh:description "Timestamp in UTC, when the last event was received (input direction) or sent (output direction)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path aas:lastUpdate ;
            sh:pattern "^-?(([1-9][0-9][0-9][0-9]+)|(0[0-9][0-9][0-9]))-((0[1-9])|(1[0-2]))-((0[1-9])|([12][0-9])|(3[01]))T(((([01][0-9])|(2[0-3])):[0-5][0-9]:([0-5][0-9])(\\.[0-9]+)?)|24:00:00(\\.0+)?)Z$" ],
        [ sh:class aas:Reference ;
            sh:description "Identifier of a supplemental semantic definition of the element. It is called supplemental semantic ID of the element." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 15 ;
            sh:path aas:supplementalSemanticIds ],
        [ sh:description "State of event." ;
            sh:in ( "True" "False" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 7 ;
            sh:path aas:state ],
        [ sh:datatype xsd:string ;
            sh:description "Information for the outer message infrastructure for scheduling the event to the respective communication channel." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path aas:messageTopic ],
        [ sh:description "Kind of the element: either type or instance." ;
            sh:in ( "Template" "Instance" ) ;
            sh:maxCount 1 ;
            sh:order 13 ;
            sh:path aas:kind ],
        [ sh:description "Direction of event." ;
            sh:in ( "Input" "Output" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 0 ;
            sh:path aas:direction ],
        [ sh:class aas:Reference ;
            sh:description "Identifier of the semantic definition of the element. It is called semantic ID of the element or also main semantic ID of the element." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 14 ;
            sh:path aas:semanticId ],
        [ sh:datatype rdf:langString ;
            sh:description "Description or comments on the element." ;
            sh:nodeKind sh:Literal ;
            sh:order 10 ;
            sh:path aas:description ],
        [ sh:datatype xsd:string ;
            sh:description "The category is a value that gives further meta information w.r.t. to the class of the element. It affects the expected existence of attributes and the applicability of constraints." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path aas:category ],
        [ sh:datatype xsd:string ;
            sh:description "Checksum to be used to determine if an Referable (including its aggregated child elements) has changed." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path aas:checksum ],
        [ sh:class aas:Extension ;
            sh:description "An extension of the element." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 18 ;
            sh:path aas:extensions ],
        [ sh:datatype rdf:langString ;
            sh:description "Display name. Can be provided in several languages." ;
            sh:nodeKind sh:Literal ;
            sh:order 11 ;
            sh:path aas:displayName ],
        [ sh:class aas:Reference ;
            sh:description "Reference to the 'Referable', which defines the scope of the event. Can be 'AssetAdministrationShell', 'Submodel', or 'SubmodelElement'." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 6 ;
            sh:path aas:observed ],
        [ sh:datatype xsd:string ;
            sh:description "For input direction: not applicable." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path aas:maxInterval ;
            sh:pattern "^-?(([1-9][0-9][0-9][0-9]+)|(0[0-9][0-9][0-9]))-((0[1-9])|(1[0-2]))-((0[1-9])|([12][0-9])|(3[01]))T(((([01][0-9])|(2[0-3])):[0-5][0-9]:([0-5][0-9])(\\.[0-9]+)?)|24:00:00(\\.0+)?)Z$" ],
        [ sh:datatype xsd:string ;
            sh:description "For input direction, reports on the maximum frequency, the software entity behind the respective Referable can handle input events." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path aas:minInterval ;
            sh:pattern "^-?(([1-9][0-9][0-9][0-9]+)|(0[0-9][0-9][0-9]))-((0[1-9])|(1[0-2]))-((0[1-9])|([12][0-9])|(3[01]))T(((([01][0-9])|(2[0-3])):[0-5][0-9]:([0-5][0-9])(\\.[0-9]+)?)|24:00:00(\\.0+)?)Z$" ],
        [ sh:datatype xsd:string ;
            sh:description "In case of identifiables this attribute is a short name of the element. In case of referable this ID is an identifying string of the element within its name space." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 12 ;
            sh:path aas:idShort ;
            sh:pattern "^[a-zA-Z][a-zA-Z0-9_]+$" ] ;
    sh:targetClass aas:BasicEventElement .

aas:Blob a sh:NodeShape ;
    sh:closed true ;
    sh:description "A 'Blob' is a data element that represents a file that is contained with its source code in the value attribute." ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class aas:Reference ;
            sh:description "Identifier of the semantic definition of the element. It is called semantic ID of the element or also main semantic ID of the element." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 8 ;
            sh:path aas:semanticId ],
        [ sh:datatype xsd:string ;
            sh:description "Checksum to be used to determine if an Referable (including its aggregated child elements) has changed." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path aas:checksum ],
        [ sh:datatype xsd:base64Binary ;
            sh:description "The value of the 'Blob' instance of a blob data element." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path aas:value ],
        [ sh:datatype rdf:langString ;
            sh:description "Description or comments on the element." ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path aas:description ],
        [ sh:description "Kind of the element: either type or instance." ;
            sh:in ( "Template" "Instance" ) ;
            sh:maxCount 1 ;
            sh:order 7 ;
            sh:path aas:kind ],
        [ sh:class aas:EmbeddedDataSpecification ;
            sh:description "Embedded data specification." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 11 ;
            sh:path aas:embeddedDataSpecifications ],
        [ sh:datatype rdf:langString ;
            sh:description "Display name. Can be provided in several languages." ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path aas:displayName ],
        [ sh:datatype xsd:string ;
            sh:description "In case of identifiables this attribute is a short name of the element. In case of referable this ID is an identifying string of the element within its name space." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path aas:idShort ;
            sh:pattern "^[a-zA-Z][a-zA-Z0-9_]+$" ],
        [ sh:datatype xsd:string ;
            sh:description "The category is a value that gives further meta information w.r.t. to the class of the element. It affects the expected existence of attributes and the applicability of constraints." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path aas:category ],
        [ sh:class aas:Reference ;
            sh:description "Identifier of a supplemental semantic definition of the element. It is called supplemental semantic ID of the element." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 9 ;
            sh:path aas:supplementalSemanticIds ],
        [ sh:class aas:Qualifier ;
            sh:description "Additional qualification of a qualifiable element." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 10 ;
            sh:path aas:qualifiers ],
        [ sh:datatype xsd:string ;
            sh:description "Content type of the content of the 'Blob'." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path aas:contentType ;
            sh:pattern "^([!#$%&'*+\\-.^_`|~0-9a-zA-Z])+/([!#$%&'*+\\-.^_`|~0-9a-zA-Z])+([ \\t]*;[ \\t]*([!#$%&'*+\\-.^_`|~0-9a-zA-Z])+=(([!#$%&'*+\\-.^_`|~0-9a-zA-Z])+|\"(([\\t !#-\\[\\]-~]|[\\x80-\\xff])|\\\\([\\t !-~]|[\\x80-\\xff]))*\"))*$" ],
        [ sh:class aas:Extension ;
            sh:description "An extension of the element." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 12 ;
            sh:path aas:extensions ] ;
    sh:targetClass aas:Blob .

aas:Capability a sh:NodeShape ;
    sh:closed true ;
    sh:description "A capability is the implementation-independent description of the potential of an asset to achieve a certain effect in the physical or virtual world." ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype rdf:langString ;
            sh:description "Description or comments on the element." ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path aas:description ],
        [ sh:class aas:EmbeddedDataSpecification ;
            sh:description "Embedded data specification." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 9 ;
            sh:path aas:embeddedDataSpecifications ],
        [ sh:class aas:Qualifier ;
            sh:description "Additional qualification of a qualifiable element." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 8 ;
            sh:path aas:qualifiers ],
        [ sh:datatype rdf:langString ;
            sh:description "Display name. Can be provided in several languages." ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path aas:displayName ],
        [ sh:class aas:Reference ;
            sh:description "Identifier of the semantic definition of the element. It is called semantic ID of the element or also main semantic ID of the element." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 6 ;
            sh:path aas:semanticId ],
        [ sh:datatype xsd:string ;
            sh:description "In case of identifiables this attribute is a short name of the element. In case of referable this ID is an identifying string of the element within its name space." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path aas:idShort ;
            sh:pattern "^[a-zA-Z][a-zA-Z0-9_]+$" ],
        [ sh:class aas:Extension ;
            sh:description "An extension of the element." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 10 ;
            sh:path aas:extensions ],
        [ sh:datatype xsd:string ;
            sh:description "Checksum to be used to determine if an Referable (including its aggregated child elements) has changed." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path aas:checksum ],
        [ sh:class aas:Reference ;
            sh:description "Identifier of a supplemental semantic definition of the element. It is called supplemental semantic ID of the element." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 7 ;
            sh:path aas:supplementalSemanticIds ],
        [ sh:datatype xsd:string ;
            sh:description "The category is a value that gives further meta information w.r.t. to the class of the element. It affects the expected existence of attributes and the applicability of constraints." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path aas:category ],
        [ sh:description "Kind of the element: either type or instance." ;
            sh:in ( "Template" "Instance" ) ;
            sh:maxCount 1 ;
            sh:order 5 ;
            sh:path aas:kind ] ;
    sh:targetClass aas:Capability .

aas:DataSpecificationIec61360 a sh:NodeShape ;
    sh:closed true ;
    sh:description "Content of data specification template for concept descriptions for properties, values and value lists conformant to IEC 61360." ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Symbol" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path aas:symbol ],
        [ sh:datatype xsd:string ;
            sh:description "Source of definition" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path aas:sourceOfDefinition ],
        [ sh:description "Set of levels." ;
            sh:in ( "Min" "Max" "Nom" "Typ" ) ;
            sh:maxCount 1 ;
            sh:order 2 ;
            sh:path aas:levelType ],
        [ sh:datatype rdf:langString ;
            sh:description "Definition in different languages" ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path aas:definition ],
        [ sh:class aas:ValueList ;
            sh:description "List of allowed values" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 11 ;
            sh:path aas:valueList ],
        [ sh:description "Data Type" ;
            sh:in ( "Date" "String" "StringTranslatable" "IntegerMeasure" "IntegerCount" "IntegerCurrency" "RealMeasure" "RealCount" "RealCurrency" "Boolean" "Iri" "Irdi" "Rational" "RationalMeasure" "Time" "Timestamp" "File" "Html" "Blob" ) ;
            sh:maxCount 1 ;
            sh:order 0 ;
            sh:path aas:dataType ],
        [ sh:datatype rdf:langString ;
            sh:description "Short name" ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path aas:shortName ],
        [ sh:class aas:Reference ;
            sh:description "Unique unit id" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 8 ;
            sh:path aas:unitId ],
        [ sh:datatype xsd:string ;
            sh:description "Unit" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path aas:unit ],
        [ sh:datatype rdf:langString ;
            sh:description "Preferred name" ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path aas:preferredName ],
        [ sh:datatype xsd:string ;
            sh:description "Value" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path aas:value ],
        [ sh:datatype xsd:string ;
            sh:description "Value Format" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 10 ;
            sh:path aas:valueFormat ] ;
    sh:targetClass aas:DataSpecificationIec61360 .

aas:DataSpecificationPhysicalUnit a sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Notation of physical unit conformant to DIN" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path aas:dinNotation ],
        [ sh:datatype xsd:string ;
            sh:description "Name of SI physical unit" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path aas:siName ],
        [ sh:datatype xsd:string ;
            sh:description "Code of physical unit conformant to ECE" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path aas:eceCode ],
        [ sh:datatype xsd:string ;
            sh:description "Name of physical unit conformant to ECE" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path aas:eceName ],
        [ sh:datatype xsd:string ;
            sh:description "Notation of SI physical unit" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path aas:siNotation ],
        [ sh:datatype xsd:string ;
            sh:description "Conversion factor" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path aas:conversionFactor ],
        [ sh:datatype xsd:string ;
            sh:description "Registration authority ID" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path aas:registrationAuthorityId ],
        [ sh:datatype xsd:string ;
            sh:description "Supplier" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 10 ;
            sh:path aas:supplier ],
        [ sh:datatype xsd:string ;
            sh:description "Source of definition" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path aas:sourceOfDefinition ],
        [ sh:datatype rdf:langString ;
            sh:description "Definition in different languages" ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path aas:definition ],
        [ sh:datatype xsd:string ;
            sh:description "Name of the physical unit" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 11 ;
            sh:path aas:unitName ],
        [ sh:datatype xsd:string ;
            sh:description "Name of NIST physical unit" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path aas:nistName ],
        [ sh:datatype xsd:string ;
            sh:description "Symbol for the physical unit" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 12 ;
            sh:path aas:unitSymbol ] ;
    sh:targetClass aas:DataSpecificationPhysicalUnit .

aas:Entity a sh:NodeShape ;
    sh:closed true ;
    sh:description "An entity is a submodel element that is used to model entities." ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class aas:Qualifier ;
            sh:description "Additional qualification of a qualifiable element." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 12 ;
            sh:path aas:qualifiers ],
        [ sh:datatype xsd:string ;
            sh:description "Checksum to be used to determine if an Referable (including its aggregated child elements) has changed." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path aas:checksum ],
        [ sh:class aas:Reference ;
            sh:description "Global identifier of the asset the entity is representing." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path aas:globalAssetId ],
        [ sh:description "Describes whether the entity is a co-managed entity or a self-managed entity." ;
            sh:in ( "CoManagedEntity" "SelfManagedEntity" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 0 ;
            sh:path aas:entityType ],
        [ sh:description "Kind of the element: either type or instance." ;
            sh:in ( "Template" "Instance" ) ;
            sh:maxCount 1 ;
            sh:order 9 ;
            sh:path aas:kind ],
        [ sh:class aas:Reference ;
            sh:description "Identifier of the semantic definition of the element. It is called semantic ID of the element or also main semantic ID of the element." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 10 ;
            sh:path aas:semanticId ],
        [ sh:datatype xsd:string ;
            sh:description "The category is a value that gives further meta information w.r.t. to the class of the element. It affects the expected existence of attributes and the applicability of constraints." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path aas:category ],
        [ sh:class aas:EmbeddedDataSpecification ;
            sh:description "Embedded data specification." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 13 ;
            sh:path aas:embeddedDataSpecifications ],
        [ sh:class aas:SubmodelElement ;
            sh:description "Describes statements applicable to the entity by a set of submodel elements, typically with a qualified value." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path aas:statements ],
        [ sh:datatype rdf:langString ;
            sh:description "Display name. Can be provided in several languages." ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path aas:displayName ],
        [ sh:datatype xsd:string ;
            sh:description "In case of identifiables this attribute is a short name of the element. In case of referable this ID is an identifying string of the element within its name space." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path aas:idShort ;
            sh:pattern "^[a-zA-Z][a-zA-Z0-9_]+$" ],
        [ sh:class aas:Reference ;
            sh:description "Identifier of a supplemental semantic definition of the element. It is called supplemental semantic ID of the element." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 11 ;
            sh:path aas:supplementalSemanticIds ],
        [ sh:class aas:SpecificAssetId ;
            sh:description "Reference to a specific asset ID representing a supplementary identifier of the asset represented by the Asset Administration Shell." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path aas:specificAssetId ],
        [ sh:class aas:Extension ;
            sh:description "An extension of the element." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 14 ;
            sh:path aas:extensions ],
        [ sh:datatype rdf:langString ;
            sh:description "Description or comments on the element." ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path aas:description ] ;
    sh:targetClass aas:Entity .

aas:Environment a sh:NodeShape ;
    sh:closed true ;
    sh:description "Container for the sets of different identifiables." ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class aas:ConceptDescription ;
            sh:description "Concept description" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path aas:conceptDescriptions ],
        [ sh:class aas:Submodel ;
            sh:description "Submodel" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path aas:submodels ],
        [ sh:class aas:AssetAdministrationShell ;
            sh:description "Asset administration shell" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path aas:assetAdministrationShells ] ;
    sh:targetClass aas:Environment .

aas:EventElement a sh:NodeShape ;
    sh:closed false ;
    sh:description "An event element." ;
    sh:ignoredProperties ( aas:lastUpdate aas:messageTopic aas:state aas:messageBroker aas:direction aas:maxInterval rdf:type aas:observed aas:minInterval ) ;
    sh:property [ sh:datatype rdf:langString ;
            sh:description "Description or comments on the element." ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path aas:description ],
        [ sh:class aas:EmbeddedDataSpecification ;
            sh:description "Embedded data specification." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 9 ;
            sh:path aas:embeddedDataSpecifications ],
        [ sh:datatype xsd:string ;
            sh:description "Checksum to be used to determine if an Referable (including its aggregated child elements) has changed." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path aas:checksum ],
        [ sh:class aas:Extension ;
            sh:description "An extension of the element." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 10 ;
            sh:path aas:extensions ],
        [ sh:datatype xsd:string ;
            sh:description "In case of identifiables this attribute is a short name of the element. In case of referable this ID is an identifying string of the element within its name space." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path aas:idShort ;
            sh:pattern "^[a-zA-Z][a-zA-Z0-9_]+$" ],
        [ sh:class aas:Reference ;
            sh:description "Identifier of a supplemental semantic definition of the element. It is called supplemental semantic ID of the element." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 7 ;
            sh:path aas:supplementalSemanticIds ],
        [ sh:class aas:Reference ;
            sh:description "Identifier of the semantic definition of the element. It is called semantic ID of the element or also main semantic ID of the element." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 6 ;
            sh:path aas:semanticId ],
        [ sh:datatype xsd:string ;
            sh:description "The category is a value that gives further meta information w.r.t. to the class of the element. It affects the expected existence of attributes and the applicability of constraints." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path aas:category ],
        [ sh:class aas:Qualifier ;
            sh:description "Additional qualification of a qualifiable element." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 8 ;
            sh:path aas:qualifiers ],
        [ sh:description "Kind of the element: either type or instance." ;
            sh:in ( "Template" "Instance" ) ;
            sh:maxCount 1 ;
            sh:order 5 ;
            sh:path aas:kind ],
        [ sh:datatype rdf:langString ;
            sh:description "Display name. Can be provided in several languages." ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path aas:displayName ] ;
    sh:targetClass aas:EventElement .

aas:EventPayload a sh:NodeShape ;
    sh:closed true ;
    sh:description "Defines the necessary information of an event instance sent out or received." ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class aas:Reference ;
            sh:description "'semanticId' of the source event element, if available" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path aas:sourceSemanticId ],
        [ sh:datatype xsd:string ;
            sh:description "Information for the outer message infrastructure for scheduling the event to the respective communication channel." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path aas:topic ],
        [ sh:class aas:Reference ;
            sh:description "Reference to the source event element, including identification of 'AssetAdministrationShell', 'Submodel', 'SubmodelElement''s." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path aas:source ],
        [ sh:datatype xsd:string ;
            sh:description "Timestamp in UTC, when this event was triggered." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path aas:timeStamp ;
            sh:pattern "^-?(([1-9][0-9][0-9][0-9]+)|(0[0-9][0-9][0-9]))-((0[1-9])|(1[0-2]))-((0[1-9])|([12][0-9])|(3[01]))T(((([01][0-9])|(2[0-3])):[0-5][0-9]:([0-5][0-9])(\\.[0-9]+)?)|24:00:00(\\.0+)?)Z$" ],
        [ sh:class aas:Reference ;
            sh:description "'semanticId' of the referable which defines the scope of the event, if available." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path aas:observableSemanticId ],
        [ sh:class aas:Reference ;
            sh:description "Reference to the referable, which defines the scope of the event." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path aas:observableReference ],
        [ sh:datatype xsd:string ;
            sh:description "Event specific payload." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path aas:payload ],
        [ sh:class aas:Reference ;
            sh:description "Subject, who/which initiated the creation." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path aas:subjectId ] ;
    sh:targetClass aas:EventPayload .

aas:File a sh:NodeShape ;
    sh:closed true ;
    sh:description "A File is a data element that represents an address to a file (a locator)." ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class aas:Qualifier ;
            sh:description "Additional qualification of a qualifiable element." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 10 ;
            sh:path aas:qualifiers ],
        [ sh:class aas:Extension ;
            sh:description "An extension of the element." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 12 ;
            sh:path aas:extensions ],
        [ sh:class aas:Reference ;
            sh:description "Identifier of a supplemental semantic definition of the element. It is called supplemental semantic ID of the element." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 9 ;
            sh:path aas:supplementalSemanticIds ],
        [ sh:datatype xsd:string ;
            sh:description "The category is a value that gives further meta information w.r.t. to the class of the element. It affects the expected existence of attributes and the applicability of constraints." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path aas:category ],
        [ sh:datatype xsd:string ;
            sh:description "Path and name of the referenced file (with file extension)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path aas:value ;
            sh:pattern "^file:(//((localhost|(\\[((([0-9A-Fa-f]{1,4}:){6}([0-9A-Fa-f]{1,4}:[0-9A-Fa-f]{1,4}|([0-9]|[1-9][0-9]|1[0-9]{2}|2[0-4][0-9]|25[0-5])\\.([0-9]|[1-9][0-9]|1[0-9]{2}|2[0-4][0-9]|25[0-5])\\.([0-9]|[1-9][0-9]|1[0-9]{2}|2[0-4][0-9]|25[0-5])\\.([0-9]|[1-9][0-9]|1[0-9]{2}|2[0-4][0-9]|25[0-5]))|::([0-9A-Fa-f]{1,4}:){5}([0-9A-Fa-f]{1,4}:[0-9A-Fa-f]{1,4}|([0-9]|[1-9][0-9]|1[0-9]{2}|2[0-4][0-9]|25[0-5])\\.([0-9]|[1-9][0-9]|1[0-9]{2}|2[0-4][0-9]|25[0-5])\\.([0-9]|[1-9][0-9]|1[0-9]{2}|2[0-4][0-9]|25[0-5])\\.([0-9]|[1-9][0-9]|1[0-9]{2}|2[0-4][0-9]|25[0-5]))|([0-9A-Fa-f]{1,4})?::([0-9A-Fa-f]{1,4}:){4}([0-9A-Fa-f]{1,4}:[0-9A-Fa-f]{1,4}|([0-9]|[1-9][0-9]|1[0-9]{2}|2[0-4][0-9]|25[0-5])\\.([0-9]|[1-9][0-9]|1[0-9]{2}|2[0-4][0-9]|25[0-5])\\.([0-9]|[1-9][0-9]|1[0-9]{2}|2[0-4][0-9]|25[0-5])\\.([0-9]|[1-9][0-9]|1[0-9]{2}|2[0-4][0-9]|25[0-5]))|(([0-9A-Fa-f]{1,4}:)?[0-9A-Fa-f]{1,4})?::([0-9A-Fa-f]{1,4}:){3}([0-9A-Fa-f]{1,4}:[0-9A-Fa-f]{1,4}|([0-9]|[1-9][0-9]|1[0-9]{2}|2[0-4][0-9]|25[0-5])\\.([0-9]|[1-9][0-9]|1[0-9]{2}|2[0-4][0-9]|25[0-5])\\.([0-9]|[1-9][0-9]|1[0-9]{2}|2[0-4][0-9]|25[0-5])\\.([0-9]|[1-9][0-9]|1[0-9]{2}|2[0-4][0-9]|25[0-5]))|(([0-9A-Fa-f]{1,4}:){2}[0-9A-Fa-f]{1,4})?::([0-9A-Fa-f]{1,4}:){2}([0-9A-Fa-f]{1,4}:[0-9A-Fa-f]{1,4}|([0-9]|[1-9][0-9]|1[0-9]{2}|2[0-4][0-9]|25[0-5])\\.([0-9]|[1-9][0-9]|1[0-9]{2}|2[0-4][0-9]|25[0-5])\\.([0-9]|[1-9][0-9]|1[0-9]{2}|2[0-4][0-9]|25[0-5])\\.([0-9]|[1-9][0-9]|1[0-9]{2}|2[0-4][0-9]|25[0-5]))|(([0-9A-Fa-f]{1,4}:){3}[0-9A-Fa-f]{1,4})?::[0-9A-Fa-f]{1,4}:([0-9A-Fa-f]{1,4}:[0-9A-Fa-f]{1,4}|([0-9]|[1-9][0-9]|1[0-9]{2}|2[0-4][0-9]|25[0-5])\\.([0-9]|[1-9][0-9]|1[0-9]{2}|2[0-4][0-9]|25[0-5])\\.([0-9]|[1-9][0-9]|1[0-9]{2}|2[0-4][0-9]|25[0-5])\\.([0-9]|[1-9][0-9]|1[0-9]{2}|2[0-4][0-9]|25[0-5]))|(([0-9A-Fa-f]{1,4}:){4}[0-9A-Fa-f]{1,4})?::([0-9A-Fa-f]{1,4}:[0-9A-Fa-f]{1,4}|([0-9]|[1-9][0-9]|1[0-9]{2}|2[0-4][0-9]|25[0-5])\\.([0-9]|[1-9][0-9]|1[0-9]{2}|2[0-4][0-9]|25[0-5])\\.([0-9]|[1-9][0-9]|1[0-9]{2}|2[0-4][0-9]|25[0-5])\\.([0-9]|[1-9][0-9]|1[0-9]{2}|2[0-4][0-9]|25[0-5]))|(([0-9A-Fa-f]{1,4}:){5}[0-9A-Fa-f]{1,4})?::[0-9A-Fa-f]{1,4}|(([0-9A-Fa-f]{1,4}:){6}[0-9A-Fa-f]{1,4})?::)|[vV][0-9A-Fa-f]+\\.([a-zA-Z0-9\\-._~]|[!$&'()*+,;=]|:)+)\\]|([0-9]|[1-9][0-9]|1[0-9]{2}|2[0-4][0-9]|25[0-5])\\.([0-9]|[1-9][0-9]|1[0-9]{2}|2[0-4][0-9]|25[0-5])\\.([0-9]|[1-9][0-9]|1[0-9]{2}|2[0-4][0-9]|25[0-5])\\.([0-9]|[1-9][0-9]|1[0-9]{2}|2[0-4][0-9]|25[0-5])|([a-zA-Z0-9\\-._~]|%[0-9A-Fa-f][0-9A-Fa-f]|[!$&'()*+,;=])*)))?/((([a-zA-Z0-9\\-._~]|%[0-9A-Fa-f][0-9A-Fa-f]|[!$&'()*+,;=]|[:@]))+(/(([a-zA-Z0-9\\-._~]|%[0-9A-Fa-f][0-9A-Fa-f]|[!$&'()*+,;=]|[:@]))*)*)?|/((([a-zA-Z0-9\\-._~]|%[0-9A-Fa-f][0-9A-Fa-f]|[!$&'()*+,;=]|[:@]))+(/(([a-zA-Z0-9\\-._~]|%[0-9A-Fa-f][0-9A-Fa-f]|[!$&'()*+,;=]|[:@]))*)*)?)$" ],
        [ sh:datatype xsd:string ;
            sh:description "In case of identifiables this attribute is a short name of the element. In case of referable this ID is an identifying string of the element within its name space." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path aas:idShort ;
            sh:pattern "^[a-zA-Z][a-zA-Z0-9_]+$" ],
        [ sh:description "Kind of the element: either type or instance." ;
            sh:in ( "Template" "Instance" ) ;
            sh:maxCount 1 ;
            sh:order 7 ;
            sh:path aas:kind ],
        [ sh:datatype xsd:string ;
            sh:description "Content type of the content of the file." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path aas:contentType ;
            sh:pattern "^([!#$%&'*+\\-.^_`|~0-9a-zA-Z])+/([!#$%&'*+\\-.^_`|~0-9a-zA-Z])+([ \\t]*;[ \\t]*([!#$%&'*+\\-.^_`|~0-9a-zA-Z])+=(([!#$%&'*+\\-.^_`|~0-9a-zA-Z])+|\"(([\\t !#-\\[\\]-~]|[\\x80-\\xff])|\\\\([\\t !-~]|[\\x80-\\xff]))*\"))*$" ],
        [ sh:datatype rdf:langString ;
            sh:description "Display name. Can be provided in several languages." ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path aas:displayName ],
        [ sh:class aas:EmbeddedDataSpecification ;
            sh:description "Embedded data specification." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 11 ;
            sh:path aas:embeddedDataSpecifications ],
        [ sh:datatype rdf:langString ;
            sh:description "Description or comments on the element." ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path aas:description ],
        [ sh:datatype xsd:string ;
            sh:description "Checksum to be used to determine if an Referable (including its aggregated child elements) has changed." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path aas:checksum ],
        [ sh:class aas:Reference ;
            sh:description "Identifier of the semantic definition of the element. It is called semantic ID of the element or also main semantic ID of the element." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 8 ;
            sh:path aas:semanticId ] ;
    sh:targetClass aas:File .

aas:HasDataSpecification a sh:NodeShape ;
    sh:closed false ;
    sh:description "Element that can be extended by using data specification templates." ;
    sh:ignoredProperties ( aas:revision rdf:type aas:version ) ;
    sh:property [ sh:class aas:EmbeddedDataSpecification ;
            sh:description "Embedded data specification." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path aas:embeddedDataSpecifications ] ;
    sh:targetClass aas:HasDataSpecification .

aas:HasExtensions a sh:NodeShape ;
    sh:closed false ;
    sh:description "Element that can be extended by proprietary extensions." ;
    sh:ignoredProperties ( aas:description aas:administration aas:displayName rdf:type aas:id aas:idShort aas:checksum aas:category ) ;
    sh:property [ sh:class aas:Extension ;
            sh:description "An extension of the element." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path aas:extensions ] ;
    sh:targetClass aas:HasExtensions .

aas:HasKind a sh:NodeShape ;
    sh:closed false ;
    sh:description "An element with a kind is an element that can either represent a template or an instance." ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:description "Kind of the element: either type or instance." ;
            sh:in ( "Template" "Instance" ) ;
            sh:maxCount 1 ;
            sh:order 0 ;
            sh:path aas:kind ] ;
    sh:targetClass aas:HasKind .

aas:HasSemantics a sh:NodeShape ;
    sh:closed false ;
    sh:description "Element that can have a semantic definition plus some supplemental semantic definitions." ;
    sh:ignoredProperties ( aas:value aas:externalSubjectId aas:valueId aas:kind aas:refersTo aas:type aas:valueType aas:name rdf:type ) ;
    sh:property [ sh:class aas:Reference ;
            sh:description "Identifier of a supplemental semantic definition of the element. It is called supplemental semantic ID of the element." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path aas:supplementalSemanticIds ],
        [ sh:class aas:Reference ;
            sh:description "Identifier of the semantic definition of the element. It is called semantic ID of the element or also main semantic ID of the element." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path aas:semanticId ] ;
    sh:targetClass aas:HasSemantics .

aas:Identifiable a sh:NodeShape ;
    sh:closed false ;
    sh:description "An element that has a globally unique identifier." ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "In case of identifiables this attribute is a short name of the element. In case of referable this ID is an identifying string of the element within its name space." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path aas:idShort ;
            sh:pattern "^[a-zA-Z][a-zA-Z0-9_]+$" ],
        [ sh:datatype rdf:langString ;
            sh:description "Description or comments on the element." ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path aas:description ],
        [ sh:datatype xsd:string ;
            sh:description "The category is a value that gives further meta information w.r.t. to the class of the element. It affects the expected existence of attributes and the applicability of constraints." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path aas:category ],
        [ sh:class aas:Extension ;
            sh:description "An extension of the element." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 7 ;
            sh:path aas:extensions ],
        [ sh:datatype xsd:string ;
            sh:description "Checksum to be used to determine if an Referable (including its aggregated child elements) has changed." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path aas:checksum ],
        [ sh:datatype xsd:string ;
            sh:description "The globally unique identification of the element." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path aas:id ],
        [ sh:datatype rdf:langString ;
            sh:description "Display name. Can be provided in several languages." ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path aas:displayName ],
        [ sh:class aas:AdministrativeInformation ;
            sh:description "Administrative information of an identifiable element." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path aas:administration ] ;
    sh:targetClass aas:Identifiable .

aas:MultiLanguageProperty a sh:NodeShape ;
    sh:closed true ;
    sh:description "A property is a data element that has a multi-language value." ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:description "Kind of the element: either type or instance." ;
            sh:in ( "Template" "Instance" ) ;
            sh:maxCount 1 ;
            sh:order 7 ;
            sh:path aas:kind ],
        [ sh:class aas:Extension ;
            sh:description "An extension of the element." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 12 ;
            sh:path aas:extensions ],
        [ sh:class aas:Reference ;
            sh:description "Identifier of the semantic definition of the element. It is called semantic ID of the element or also main semantic ID of the element." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 8 ;
            sh:path aas:semanticId ],
        [ sh:datatype xsd:string ;
            sh:description "The category is a value that gives further meta information w.r.t. to the class of the element. It affects the expected existence of attributes and the applicability of constraints." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path aas:category ],
        [ sh:datatype rdf:langString ;
            sh:description "Display name. Can be provided in several languages." ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path aas:displayName ],
        [ sh:datatype rdf:langString ;
            sh:description "The value of the property instance." ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path aas:value ],
        [ sh:datatype xsd:string ;
            sh:description "Checksum to be used to determine if an Referable (including its aggregated child elements) has changed." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path aas:checksum ],
        [ sh:class aas:EmbeddedDataSpecification ;
            sh:description "Embedded data specification." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 11 ;
            sh:path aas:embeddedDataSpecifications ],
        [ sh:class aas:Qualifier ;
            sh:description "Additional qualification of a qualifiable element." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 10 ;
            sh:path aas:qualifiers ],
